@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@inject AppState State
@inject LlamaClient Client
@inject LlamaModelInfoClient ModelInfo
@inject MobileUiDispatcher Ui
@inject PaperDocumentState Paper
@inject IJSRuntime JS
@inject ChronicleImageAssetStore ChronicleImages
@inject PlayerImageAssetStore PlayerImages
@inject NpcPortraitStore PortraitStore

<main class="mobile-shell">
    <header class="mobile-header">
        <button class="mobile-icon-button" aria-label="Campaigns and Sessions" title="Campaigns and Sessions" @onclick="OpenNavigation"><svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" /></svg></button>
        <div class="mobile-title"><strong>DBLC</strong><span>@(State.ActiveCampaign?.Name ?? "Campaign") · Session @(State.Current?.SessionNumber ?? 1)@(State.Current?.IsWorkbench == true ? " · Workbench" : "")</span></div>
        <button class="mobile-icon-button" aria-label="Your Desk" title="Your Desk" @onclick="() => DeskOpen = true"><svg viewBox="0 0 24 24"><path d="M4 5.5h6.5c1 0 1.5.5 1.5 1.5v12c0-1-1-1.5-2-1.5H4zM20 5.5h-6.5c-1 0-1.5.5-1.5 1.5v12c0-1 1-1.5 2-1.5h6z" /></svg></button>
    </header>

    @if (ActiveSpace == "Table")
    {
    <section class="mobile-chronicle-viewport">
        <div class="messages mobile-messages @(NeedsInitialPosition ? "chronicle-positioning" : "")" style="--chronicle-text-scale: @State.ChronicleTextScaleCss" @ref="MessagesElement">
            <div class="messages-content">
                @if (!string.IsNullOrWhiteSpace(State.Current?.OpeningSummary))
                {
                    <article class="session-opening-summary"><div class="session-opening-heading">PREVIOUS SESSION · @(State.Current?.PreviousSessionNumber ?? 0)</div><div><ChronicleText Text="@State.Current!.OpeningSummary" /></div></article>
                }
                @if (_chronicle.Lines.Count == 0)
                {
                    <div class="welcome-card"><div class="welcome-mark"><GmThinkingSigil Size="144" Label="DBLC" /></div><div class="eyebrow">THE TABLE IS YOURS</div><h2>What happens next?</h2><p>Ask your GM anything. It can inspect the book catalogue and request pages when it needs them.</p></div>
                }
                @foreach (var line in _chronicle.Lines)
                {
                    if (line.Role == "archive")
                    {
                        <article class="archive-summary-card"><div class="archive-summary-heading"><span>✧</span><span>ARCHIVED CHRONICLE SUMMARY</span><small>Original lines preserved locally</small></div><div class="archive-summary-content"><ChronicleText Text="@line.Content" /></div></article>
                    }
                    else if (line.EntryType == "campaign_record")
                    {
                        <article class="campaign-record-message"><div class="campaign-record-label">CAMPAIGN RECORD</div><div class="campaign-record-content message-content"><ChronicleText Text="@line.Content" /></div></article>
                    }
                    else if (State.Busy && State.GmThinkingSigilEnabled && line.Role == "assistant" && string.IsNullOrEmpty(line.Content) && line.PresentationSegments is not { Count: > 0 } && _chronicle.Lines.LastOrDefault()?.Id == line.Id)
                    {
                        @* The aligned thinking row below represents this still-empty GM response. *@
                    }
                    else
                    {
                        <article @key="line.Id" class="message @(line.Role == "user" ? "user-message" : "gm-message")">
                            @if (line.Role != "assistant" || line.PresentationSegments is not { Count: > 0 }) {
                                    <div class="avatar">
                                @if (line.Role == "user" && CurrentPlayerPortrait is { } playerPortrait) { <img src="@playerPortrait.DataUrl" alt="" style="@PlayerIdentityImageStyle(playerPortrait.Frame)" /> }
                                else if (line.Role == "user" && !string.IsNullOrWhiteSpace(CurrentPlayerName)) { @IdentityInitial(CurrentPlayerName) }
                                else { @(line.Role == "user" ? State.PlayerMark : line.GmMark ?? State.GetGmMark(State.Model)) }
                            </div>
                                    }
                            <div class="message-body">
                                @if (line.Role == "assistant" && line.PresentationSegments is { Count: > 0 } segments)
                                {
                                    @for (var i = 0; i < segments.Count; i++)
                                    {
                                        var segment = segments[i];
                                        var showSpeakerHeader = i == 0 || !string.Equals(segments[i - 1].Speaker, segment.Speaker, StringComparison.OrdinalIgnoreCase);
                                        var speakerNpc = ResolveSpeakerNpc(segment);
                                        var speakerPortrait = speakerNpc is null ? null : PortraitStore.BrowserImageUrl(State.Current!.CampaignId, speakerNpc.Id, speakerNpc.PortraitExtension);
                                        var liveGmResponse = State.Busy && line.Role == "assistant" && _chronicle.Lines.LastOrDefault()?.Id == line.Id;
                                        <div class="gm-expression-segment">
                                            @if (showSpeakerHeader)
                                            {
                                                <div class="avatar speaker-avatar">
                                                    @if (string.Equals(segment.Speaker, "GM", StringComparison.OrdinalIgnoreCase)) { @(line.GmMark ?? State.GetGmMark(State.Model)) }
                                                    else if (speakerPortrait is not null) { <img src="@speakerPortrait" alt="" style="@NpcSpeakerPortraitStyle(speakerNpc!)" /> }
                                                    else { @IdentityInitial(segment.Speaker) }
                                                </div>
                                            }
                                            else { <div class="avatar speaker-avatar speaker-avatar-spacer" aria-hidden="true"></div> }
                                            <div class="gm-expression-content">
                                                @if (showSpeakerHeader) { <div class="message-meta speaker-meta"><span>@(string.Equals(segment.Speaker, "GM", StringComparison.OrdinalIgnoreCase) ? "THE GM" : segment.Speaker)</span><span class="speaker-time">@(i == 0 ? line.DisplayTimestamp.ToLocalTime().ToString("h:mm tt") : "")</span></div> }
                                                <div class="message-content @(MobileFlavorClass(segment.Flavor))" data-clean-text="@segment.Text"><ChronicleText @key="segment.Id" Text="@segment.Text" Flavor="@segment.Flavor" Seed="@segment.GlitchSeed" StableKey="@($"{line.Id:N}:{segment.Id:N}")" FlavorsEnabled="@State.GmFlavorFontsEnabled" AnimationsEnabled="@State.GmStreamAnimationsEnabled" DefaultEffect="@State.GmStreamDefaultEffect" InlineEffectsEnabled="@State.GmInlineStreamEffectsEnabled" EffectSpans="@segment.NarrationEffectSpans" IsLiveResponse="@liveGmResponse" /></div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    var liveGmResponse = State.Busy && line.Role == "assistant" && _chronicle.Lines.LastOrDefault()?.Id == line.Id;
                                    <div class="message-meta">@(line.Role == "user" ? (string.IsNullOrWhiteSpace(CurrentPlayerName) ? "YOU" : CurrentPlayerName) : "THE GM") <span>@line.DisplayTimestamp.ToLocalTime().ToString("h:mm tt")</span></div><div class="message-content">@if (line.RollSides is not null) { @line.RollDisplayText } else { <ChronicleText Text="@line.Content" StableKey="@($"{line.Id:N}:0")" AnimationsEnabled="@State.GmStreamAnimationsEnabled" DefaultEffect="@State.GmStreamDefaultEffect" InlineEffectsEnabled="@State.GmInlineStreamEffectsEnabled" EffectSpans="@line.NarrationEffectSpans" IsLiveResponse="@liveGmResponse" /> }</div>
                                }
                                @if (line.Role == "user" && line.ImageAttachmentKey is { } key && GetImage(line, key) is { } image)
                                {
                                    <button class="chronicle-image-attachment" type="button" title="View attached image" @onclick="() => OpenImage(image)"><img src="@image" alt="Image attached to this message" loading="lazy" /></button>
                                }
                                @if (line.Role == "assistant" && line.EntryType != ChatLine.TechnicalErrorEntryType && !string.IsNullOrWhiteSpace(line.Content) &&
                                            line.Content != "(The model returned no text.)")
                                {
                                    <GmNoteReferences References="line.GmNoteReferences" Sources="line.SourceReferences" AllowPrivateSources="false" OnOpen="OpenGmNoteReference" OnOpenSource="OpenSourceReference" />
                                }
                            </div>
                        </article>
                    }
                }
                @if (State.Busy && (State.GmThinkingSigilEnabled || _chronicle.Lines.LastOrDefault()?.Content.Length == 0))
                {
                    <div class="typing">
                        @if (State.GmThinkingSigilEnabled)
                        {
                            <div class="typing-avatar"><GmThinkingSigil Size="54" /></div>
                        }
                        else
                        {
                            <span></span><span></span><span></span><em>@ActivityLabel</em>
                        }
                    </div>
                }
                @if (_chronicle.Lines.Count > 0) { <div class="scroll-anchor"></div> }
            </div>
        </div>
        <button @ref="JumpButton" class="chronicle-jump-button" type="button" aria-label="Jump to latest" title="Jump to latest" aria-hidden="true" tabindex="-1" @onclick="JumpToLatest"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v15m-6-6 6 6 6-6" /></svg></button>
    </section>

    <div class="mobile-context"><div style="width:@ContextWidth"></div></div>
    @if (!string.IsNullOrWhiteSpace(MobileSubmitError)) { <p class="player-update-error" role="status">@MobileSubmitError</p> }
    <form class="mobile-composer" @ref="ComposerElement" @onsubmit="Submit" @onsubmit:preventDefault>
        <textarea @ref="ComposerInputElement" @bind="Draft" @bind:event="oninput" rows="1" placeholder="@(State.Busy ? "Add a steer…" : "Message the GM…")" disabled="@(State.Busy && !State.CanSteerCurrentResponse || State.Current?.IsEnded == true)"></textarea>
        <DiceRoller @bind-SelectedSides="SelectedDieSides" Compact="true" Disabled="@(State.Busy || _submitStarting || State.Current?.IsEnded == true)" ConversationId="@(State.Current?.Id)" OnRoll="RecordPlayerRoll" />
        <button class="mobile-send" type="submit" aria-label="@(State.Busy && string.IsNullOrWhiteSpace(Draft) ? "Stop generation" : State.Busy ? "Steer the GM" : "Send")" disabled="@(State.Busy && !State.CanSteerCurrentResponse || State.Current?.IsEnded == true)">
            @if (State.Busy && string.IsNullOrWhiteSpace(Draft)) { <svg viewBox="0 0 24 24"><rect x="7" y="7" width="10" height="10" rx="1" /></svg> }
            else { <svg viewBox="0 0 24 24"><path d="M4 12h15m-6-6 6 6-6 6" /></svg> }
        </button>
    </form>
    }
    else
    {
        <div class="mobile-space-host-container">
            <AppShell MobileHost="true" MobileSection="@ActiveSpace" FocusedGmNoteId="@FocusedGmNoteId" OnMobileClose="ReturnToTable" />
        </div>
    }

    @if (NavigationOpen)
    {
        <div class="mobile-overlay" @onclick="CloseNavigation">
            <nav @ref="NavigationDrawer" class="mobile-drawer" aria-label="Campaign and Session navigation" @onclick:stopPropagation>
                <div class="mobile-panel-heading"><div><div class="eyebrow">CAMPAIGNS</div><h2>Choose a campaign</h2></div><button class="mobile-icon-button" aria-label="Close" @onclick="CloseNavigation">×</button></div>
                @if (!string.IsNullOrWhiteSpace(MobileNavigationError)) { <p class="player-update-error" role="status">@MobileNavigationError</p> }
                <button class="mobile-nav-row mobile-table-link" @onclick="ReturnToTable">Table · Return to Chronicle</button>
                @foreach (var campaign in State.Campaigns)
                {
                    <button class="mobile-nav-row @(campaign.Id == State.ActiveCampaignId ? "selected" : "")" @onclick="() => SelectCampaign(campaign.Id)">@campaign.Name</button>
                }
                <div class="mobile-panel-heading mobile-session-heading"><div><div class="eyebrow">SESSIONS · @State.ActiveConversations.Count()</div><h2>@State.ActiveCampaign?.Name</h2></div><button class="mobile-small-button" disabled="@State.Busy" @onclick="CreateSession">＋ New</button></div>
                @foreach (var session in State.ActiveConversations)
                {
                    <div class="mobile-session-row" data-mobile-session-id="@session.Id.ToString("N")">
                        <button class="mobile-nav-row @(session.Id == State.Current?.Id ? "selected" : "")" @onclick="() => SelectSession(session.Id)"><small>SESSION @(session.SessionNumber ?? 1)@(session.IsEnded ? " · ENDED" : "")</small><span>@session.Title</span></button>
                        <button class="mobile-session-options" type="button" aria-label="Options for Session @(session.SessionNumber ?? 1): @session.Title" title="Session options" @onclick="() => OpenMobileSessionMenu(session)">⋯</button>
                    </div>
                    @foreach (var workbench in State.GetWorkbenches(session.Id))
                    {
                        <button class="mobile-nav-row mobile-workbench-row @(workbench.Id == State.Current?.Id ? "selected" : "")" @onclick="() => SelectSession(workbench.Id)">└─ @workbench.Title</button>
                    }
                }
                @if (State.Current is { IsWorkbench: true } && !State.Busy)
                {
                    <div class="mobile-workbench-actions">
                        <button class="mobile-session-action" @onclick="RequestMobileWorkbenchExit" disabled="@(State.Busy || State.WorkbenchExitReviewBusy)">@(State.WorkbenchExitReviewPreparing ? "Checking…" : "Review & End")</button>
                        <button class="mobile-session-action danger-action" @onclick="DiscardMobileWorkbenchNow" disabled="@(State.Busy || State.WorkbenchExitReviewBusy)">Discard &amp; Exit</button>
                    </div>
                }
                @if (State.Current is { IsWorkbench: false, IsEnded: false } && !State.Busy)
                {
                    <div class="mobile-workbench-create"><input @bind="WorkbenchName" maxlength="80" placeholder="Workbench name" /><button class="mobile-small-button" @onclick="CreateWorkbench">Create Workbench</button></div>
                }
            </nav>
        </div>
    }

    @if (MobileMenuSession is { } menuSession)
    {
        <div class="mobile-session-menu-backdrop" @onclick="CloseMobileSessionMenu">
            <section class="mobile-session-menu" role="dialog" aria-modal="true" aria-label="Session options" @onclick:stopPropagation>
                <div class="mobile-sheet-handle"></div>
                <div class="mobile-panel-heading"><div><div class="eyebrow">SESSION @(menuSession.SessionNumber ?? 1)@(menuSession.IsEnded ? " · ENDED" : "")</div><h2>@menuSession.Title</h2></div><button class="mobile-icon-button" aria-label="Close Session options" @onclick="CloseMobileSessionMenu">×</button></div>
                @if (menuSession.Id == State.Current?.Id && !menuSession.IsWorkbench && !menuSession.IsEnded)
                {
                    <button class="mobile-session-action" disabled="@(State.Busy || MobileSessionActionBusy)" @onclick="() => RunMobileSessionSummary(endAfterSummary: false)">@(MobileSessionActionBusy && !MobileEndingSession ? "Summarizing…" : "Summarize Session")</button>
                    <button class="mobile-session-action danger-action" disabled="@(State.Busy || MobileSessionActionBusy)" @onclick="() => RunMobileSessionSummary(endAfterSummary: true)">@(MobileSessionActionBusy && MobileEndingSession ? "Ending…" : "End Session")</button>
                    @if (!string.IsNullOrWhiteSpace(MobileSessionActionError)) { <p class="player-update-error" role="status">@MobileSessionActionError</p> }
                }
                <button class="mobile-session-action" @onclick="BeginMobileRename">Rename</button>
                <button class="mobile-session-action" disabled="@(State.Busy || MobileSessionActionBusy)" @onclick="DuplicateMobileSession">Duplicate</button>
                <button class="mobile-session-action" @onclick="ExportMobileSession">Export Chronicle</button>
                <button class="mobile-session-action danger-action" disabled="@State.Busy" @onclick="ConfirmMobileDelete">Delete Session</button>
            </section>
        </div>
    }
    @if (MobileRenamingSession is { } renameSession)
    {
                <div class="mobile-session-dialog-backdrop" @onclick="CancelMobileRename"><section class="mobile-session-dialog" role="dialog" aria-modal="true" aria-label="Rename Session" @onclick:stopPropagation><div class="eyebrow">SESSION @(renameSession.SessionNumber ?? 1)</div><h2>Rename Session</h2><input @bind="MobileRenameDraft" @bind:event="oninput" maxlength="120" aria-label="Session name" @onkeydown="HandleMobileRenameKey" /><div class="mobile-session-dialog-actions"><button class="mobile-session-action" @onclick="CancelMobileRename">Cancel</button><button class="mobile-session-action" @onclick="SaveMobileRename">Save name</button></div></section></div>
    }
    @if (MobileDeletingSession is { } deleteSession)
    {
        <div class="mobile-session-dialog-backdrop" @onclick="CancelMobileDelete"><section class="mobile-session-dialog" role="dialog" aria-modal="true" aria-label="Confirm Session deletion" @onclick:stopPropagation><div class="eyebrow">SESSION @(deleteSession.SessionNumber ?? 1)</div><h2>Delete this Session?</h2><p>“@deleteSession.Title” and its Chronicle will be deleted. This can't be undone.</p><div class="mobile-session-dialog-actions"><button class="mobile-session-action" @onclick="CancelMobileDelete">Cancel</button><button class="mobile-session-action danger-action" @onclick="DeleteMobileSession">Delete Session</button></div></section></div>
    }

    @if (DeskOpen)
    {
        <div class="mobile-sheet-backdrop" @onclick="CloseDesk">
            <section class="mobile-desk-sheet" role="dialog" aria-modal="true" aria-label="Your Desk" @onclick:stopPropagation>
                <div class="mobile-sheet-handle"></div><div class="mobile-panel-heading"><div><div class="eyebrow">DBLC · REFERENCE</div><h2>Your Desk</h2></div><button class="mobile-icon-button" aria-label="Close Your Desk" @onclick="CloseDesk">×</button></div>
                <div class="mobile-desk-grid">
                    @foreach (var deskEntry in DeskSections)
                    {
                        var sectionTitle = deskEntry.Available ? deskEntry.Name : "Available in the next mobile interface stage";
                        <button class="mobile-desk-item @(ActiveSpace == deskEntry.Name ? "selected" : "")" @onclick="() => OpenDeskSection(deskEntry.Name)" title="@sectionTitle"><span>@((MarkupString)deskEntry.Icon)</span><small>@deskEntry.Name</small></button>
                    }
                </div>
                <p class="mobile-desk-note">These spaces use the same campaign data and tools as DBLC on this PC.</p>
            </section>
        </div>
    }

    @if (ShowImageViewer && ViewerDataUrl is { } dataUrl)
    {
        <div class="mobile-image-viewer" role="dialog" aria-modal="true" @onclick="CloseImage"><button aria-label="Close image" @onclick="CloseImage">×</button><img src="@dataUrl" alt="Chronicle attachment" /></div>
    }

    @if (ActiveSpace == "Table" && State.PendingPlayerUpdate is { } playerProposal)
    {
        <div class="mobile-approval-backdrop">
            <section class="mobile-approval-dialog" role="dialog" aria-modal="true" aria-label="Review Player Sheet update">
                <div class="mobile-panel-heading"><div><div class="eyebrow">PLAYER SHEET UPDATE</div><h2>Review proposed update</h2></div></div>
                <div class="mobile-review-switch" role="tablist" aria-label="Player Sheet versions">
                    <button role="tab" aria-selected="@(MobilePlayerReviewUpdated == false)" class="@(MobilePlayerReviewUpdated ? "" : "selected")" @onclick="() => MobilePlayerReviewUpdated = false">Original</button>
                    <button role="tab" aria-selected="@MobilePlayerReviewUpdated" class="@(MobilePlayerReviewUpdated ? "selected" : "")" @onclick="() => MobilePlayerReviewUpdated = true">Updated</button>
                </div>
                <div class="mobile-approval-document markdown-preview">
                    @if (MobilePlayerReviewUpdated)
                    {
                        @((MarkupString)PlayerMarkdownRenderer.Render(playerProposal.UpdatedMarkdown, playerProposal.CampaignId, PlayerImages, interactive: false))
                    }
                    else if (string.IsNullOrWhiteSpace(playerProposal.OriginalMarkdown))
                    {
                        <p class="player-update-empty">Player Sheet is empty.</p>
                    }
                    else
                    {
                        @((MarkupString)PlayerMarkdownRenderer.Render(playerProposal.OriginalMarkdown, playerProposal.CampaignId, PlayerImages, interactive: false))
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(MobilePlayerApprovalError)) { <p class="player-update-error">@MobilePlayerApprovalError</p> }
                <div class="mobile-approval-actions"><button class="outline-button" @onclick="CancelMobilePlayerUpdate" disabled="@MobilePlayerApplying">Cancel</button><button class="primary-button small" @onclick="() => ApproveMobilePlayerUpdate(playerProposal)" disabled="@MobilePlayerApplying">@(MobilePlayerApplying ? "Saving…" : "Apply Update")</button></div>
            </section>
        </div>
    }
    @if (ActiveSpace == "Table" && State.PendingGmNote is { } gmNoteProposal)
    {
        <div class="mobile-approval-backdrop">
            <section class="mobile-approval-dialog" role="dialog" aria-modal="true" aria-label="Review GM Note proposal">
                <div class="mobile-panel-heading"><div><div class="eyebrow">CAMPAIGN NOTEBOOK</div><h2>Save this GM Note?</h2></div></div>
                <p class="gm-note-proposal-copy">This will be saved as durable campaign reference.</p>
                <div class="mobile-approval-document mobile-proposal-text">@gmNoteProposal.Text</div>
                @if (!string.IsNullOrWhiteSpace(MobileGmNoteApprovalError)) { <p class="player-update-error">@MobileGmNoteApprovalError</p> }
                <div class="mobile-approval-actions"><button class="outline-button" @onclick="CancelMobileGmNote">Cancel</button><button class="primary-button small" @onclick="() => ApproveMobileGmNote(gmNoteProposal)">Save GM Note</button></div>
            </section>
        </div>
    }
    @if (ActiveSpace == "Table" && State.PendingBestiaryProposal is { } bestiaryProposal)
    {
        <div class="mobile-approval-backdrop">
            <section class="mobile-approval-dialog" role="dialog" aria-modal="true" aria-label="Review Bestiary proposal">
                <div class="mobile-panel-heading"><div><div class="eyebrow">@(bestiaryProposal.IsCreate ? "ADD TO BESTIARY" : $"BESTIARY UPDATE · {bestiaryProposal.Updated.Name.ToUpperInvariant()}")</div><h2>@(bestiaryProposal.IsCreate ? bestiaryProposal.Updated.Name : "Review proposed card")</h2></div></div>
                @if (bestiaryProposal.IsCreate)
                {
                    <div class="mobile-approval-document bestiary-create-preview"><BestiaryCardView Entry="bestiaryProposal.Updated" PortraitDataUrl="@PortraitStore.ReadBestiaryDataUrl(bestiaryProposal.CampaignId, bestiaryProposal.Updated.Id, bestiaryProposal.Updated.PortraitExtension)" Frame="@PortraitStore.ReadBestiaryFrame(bestiaryProposal.CampaignId, bestiaryProposal.Updated.Id, bestiaryProposal.Updated.PortraitExtension)" /></div>
                }
                else if (bestiaryProposal.Original is { } originalBestiary)
                {
                    <div class="mobile-review-switch" role="tablist" aria-label="Bestiary card versions"><button role="tab" aria-selected="@(MobileBestiaryReviewUpdated == false)" class="@(MobileBestiaryReviewUpdated ? "" : "selected")" @onclick="() => MobileBestiaryReviewUpdated = false">Original</button><button role="tab" aria-selected="@MobileBestiaryReviewUpdated" class="@(MobileBestiaryReviewUpdated ? "selected" : "")" @onclick="() => MobileBestiaryReviewUpdated = true">Updated</button></div>
                    <div class="mobile-approval-document mobile-bestiary-review"><BestiaryCardView Entry="@(MobileBestiaryReviewUpdated ? bestiaryProposal.Updated : originalBestiary)" PortraitDataUrl="@PortraitStore.ReadBestiaryDataUrl(bestiaryProposal.CampaignId, originalBestiary.Id, originalBestiary.PortraitExtension)" Frame="@PortraitStore.ReadBestiaryFrame(bestiaryProposal.CampaignId, originalBestiary.Id, originalBestiary.PortraitExtension)" /></div>
                }
                @if (!string.IsNullOrWhiteSpace(MobileBestiaryApprovalError)) { <p class="player-update-error">@MobileBestiaryApprovalError</p> }
                <div class="mobile-approval-actions"><button class="outline-button" @onclick="CancelMobileBestiary">Cancel</button><button class="primary-button small" @onclick="() => ApproveMobileBestiary(bestiaryProposal)">@(bestiaryProposal.IsCreate ? "Add to Bestiary" : "Apply Update")</button></div>
            </section>
        </div>
    }
    @if (State.PendingWorkbenchCreation is { } workbenchRequest)
    {
        <div class="mobile-approval-backdrop">
            <section class="mobile-approval-dialog" role="dialog" aria-modal="true" aria-label="Workbench request">
                <div class="mobile-panel-heading"><div><div class="eyebrow">GM REQUEST</div><h2>Open “@workbenchRequest.Name”?</h2></div></div>
                <p>The GM would like to move this discussion into a temporary Workbench. Your Session Chronicle will stay separate.</p>
                <div class="mobile-approval-actions"><button class="outline-button" @onclick="() => State.ResolveWorkbenchCreation(workbenchRequest.Id, false)">Stay in Session</button><button class="primary-button small" @onclick="() => State.ResolveWorkbenchCreation(workbenchRequest.Id, true)">Open Workbench</button></div>
            </section>
        </div>
    }
    @if (State.PendingWorkbenchExitReview is { } workbenchExit)
    {
        <div class="mobile-approval-backdrop">
            <section class="mobile-approval-dialog" role="dialog" aria-modal="true" aria-label="Review Workbench exit">
                <div class="mobile-panel-heading"><div><div class="eyebrow">@workbenchExit.Name</div><h2>End Workbench?</h2></div></div>
                @if (workbenchExit.Artifacts.Count > 0)
                {
                    <div class="workbench-exit-label">ALREADY RETAINED</div>
                    <ul class="workbench-artifacts">@foreach (var artifact in workbenchExit.Artifacts) { <li>✓ @artifact</li> }</ul>
                }
                <div class="mobile-approval-document">
                    <div class="workbench-exit-label">RETAIN IN CHRONICLE</div>
                    @if (workbenchExit.Retention.ChronicleFacts.Count == 0) { <p>No established fictional facts will be retained.</p> }
                    else { @foreach (var fact in workbenchExit.Retention.ChronicleFacts) { <blockquote>@fact</blockquote> } }
                    <div class="workbench-exit-label">GM NOTES</div>
                    @if (workbenchExit.Retention.Notes.Count == 0) { <p>No GM Notes will be retained.</p> }
                    else { @foreach (var note in workbenchExit.Retention.Notes) { <blockquote>@note</blockquote> } }
                </div>
                <p class="workbench-discard-copy">Saved campaign artifacts are unaffected. If you approve or discard, the Workbench will close after the GM reply completes.</p>
                @if (!string.IsNullOrWhiteSpace(MobileWorkbenchExitError)) { <p class="player-update-error">@MobileWorkbenchExitError</p> }
