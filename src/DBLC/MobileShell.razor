    private void QueueRender()
    {
        if (_disposed || Interlocked.Exchange(ref _renderQueued, 1) != 0) return;
        _ = RenderAfterCoalescingAsync();
    }

    private async Task RenderAfterCoalescingAsync()
    {
        await Task.Delay(30);
        if (_disposed) { Interlocked.Exchange(ref _renderQueued, 0); return; }
        var revision = Volatile.Read(ref _stateRevision);
        var snapshotTimer = System.Diagnostics.Stopwatch.StartNew();
        var snapshot = await Ui.InvokeAsync(() => MobileChronicleSnapshot.Capture(State.Current));
        await InvokeAsync(() =>
        {
            Interlocked.Exchange(ref _renderQueued, 0);
            if (_disposed) return;
            if (_chronicle.SessionId != snapshot.SessionId)
                new GmRequestDiagnostics().RecordMobileSnapshot("session_switch", snapshotTimer.Elapsed, snapshot.Lines.Count);
            _chronicle = snapshot;
            StateHasChanged();
            // A final state change can arrive while the dispatcher snapshot is in flight.
            if (revision != Volatile.Read(ref _stateRevision)) QueueRender();
        });
    }

