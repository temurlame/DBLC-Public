    private async Task SubmitCore(string text, bool fromComposer, string? internalInstruction = null)
    {
        MobileSubmitError = "";
        if (State.Busy)
        {
            if (!fromComposer) return;
            if (text.Length == 0) { await Ui.InvokeAsync(State.StopCurrentResponse); return; }
            if (await Ui.InvokeAsync(() => State.SteerCurrentResponse(text))) Draft = "";
            else MobileSubmitError = "The active GM turn belongs to another Session or is finishing. Your draft was kept.";
            return;
        }
        Task? task = null;
        var sourceConversation = State.Current;
        if (sourceConversation is null) { MobileSubmitError = "No Session is selected. Your draft was kept."; return; }
        async Task<string> RequestWorkbenchEndFromGm(WorkbenchExitRetention retention)
        {
            if (sourceConversation is not { IsWorkbench: true } workbench || State.Current?.Id != workbench.Id)
                return "The player is no longer in this Workbench. It was not ended.";
            if (!State.TryBeginWorkbenchExitReview(workbench.Id, out var reservation))
                return "A Workbench exit review is already being prepared or reviewed. Do not request another one.";
            try
            {
                Paper.SaveAll();
                if (!State.PublishWorkbenchExitReview(reservation, retention, out var approval) || approval is null)
                    return "DBLC could not open the shared Workbench exit review. The Workbench remains open.";
                return await approval;
            }
            catch (Exception ex)
            {
                State.CancelWorkbenchExitReviewPreparation(reservation);
                return "DBLC could not open the Workbench exit review, so the Workbench remains open. " + ex.Message;
            }
        }
        var accepted = false;
        string? resolvedModelId = null;
        try { resolvedModelId = await ModelInfo.GetModelIdAsync(State.Endpoint); } catch { }
        await Ui.InvokeAsync(() =>
        {
            task = State.SendAsync(text, Client, resolvedModelId, readPlayer: Paper.ReadPlayerMarkdown, readWorkspace: Paper.ReadWorkspaceNotes,
                requestWorkbenchEnd: RequestWorkbenchEndFromGm, expectedConversationId: sourceConversation.Id, internalInstruction: internalInstruction,
                onAccepted: () => accepted = true, onRejected: reason => MobileSubmitError = reason);
        });
        if (!accepted) { await InvokeAsync(StateHasChanged); return; }
        _submitStarting = false;
        if (fromComposer) Draft = "";
        await InvokeAsync(StateHasChanged);
        await task!;
    }

