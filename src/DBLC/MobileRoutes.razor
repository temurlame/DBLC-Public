@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

<Router AppAssembly="typeof(MobileShell).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData">
            <NotAuthorized><p class="mobile-auth-needed">Sign in to DBLC from the login page.</p></NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound><PageTitle>DBLC</PageTitle><p class="mobile-auth-needed">This DBLC page was not found.</p></NotFound>
</Router>
