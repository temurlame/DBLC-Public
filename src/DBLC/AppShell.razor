                </section>
                    </div>
                }
                    </div>
                </div>
                <div class="settings-foot"><span>Sessions are stored on this device.</span><button class="primary-button small" @onclick="SaveSettings">Save settings</button></div>
            </section>
        }

                <div class="workspace">
            @if (ActiveView == "Workspace")
            {
                <PaperView ViewName="Workspace" BrowserHost="@MobileHost" />
