    private long _lastSubmitTick;
    private async Task SendForm()
    {
        var now = Environment.TickCount64;
        if (now - _lastSubmitTick < 400) return;
        _lastSubmitTick = now;
        await SendPrompt(Draft.Trim(), fromComposer: true);
    }
    private async Task SendPrompt(string prompt, bool fromComposer, string? internalInstruction = null)
    {
        if (ResolvingModel || SessionActionBusy || State.Current?.IsEnded == true) return;
        if (State.Busy)
        {
            if (!fromComposer) return;
            if (prompt.Length == 0)
            {
                State.StopCurrentResponse();
                return;
            }
            if (State.SteerCurrentResponse(prompt))
            {
                Draft = "";
                try { await JS.InvokeVoidAsync("clearComposer", ComposerElement); } catch { }
            }
            else SessionActionStatus = "The active GM turn belongs to another Session or is finishing. Your draft was kept.";
            return;
        }
        var sourceConversation = State.Current;
        if (sourceConversation is null) return;
        ComposerImageDraft? attachment = fromComposer && State.VisionEnabled ? ComposerImage : null;
        SessionActionStatus = ""; ResolvingModel = true;
        var diagnostics = new GmRequestDiagnostics();
        var discovery = System.Diagnostics.Stopwatch.StartNew();
        try { await RefreshModelId(); }
        finally { ResolvingModel = false; }
        diagnostics.RecordPreflight("model_id_and_context_discovery", discovery.Elapsed);
        if (!State.VisionEnabled) { attachment = null; if (fromComposer) RemoveComposerImage(); }
        string? imageKey = null;
        LlamaVisionImage? visionImage = null;
        if (attachment is not null && State.Current?.Id == sourceConversation.Id)
        {
            try
            {
                imageKey = ChronicleImages.Save(sourceConversation.CampaignId, sourceConversation.Id, attachment.Name, attachment.Bytes);
                visionImage = new LlamaVisionImage(attachment.MimeType, $"data:{attachment.MimeType};base64,{Convert.ToBase64String(attachment.Bytes)}");
            }
            catch (Exception ex)
            {
                if (fromComposer) Draft = prompt;
                ComposerImageError = "Could not save the attached image: " + ex.Message;
                return;
            }
        }
        try
        {
            async Task<string> RequestWorkbenchEndFromGm(WorkbenchExitRetention retention)
            {
                if (sourceConversation is not { IsWorkbench: true } workbench || State.Current?.Id != workbench.Id)
                    return "The player is no longer in this Workbench. It was not ended.";
                if (!State.TryBeginWorkbenchExitReview(workbench.Id, out var reservation))
                    return "A Workbench exit review is already being prepared or reviewed. Do not request another one.";
                try
                {
                    Paper.SaveAll();
                    if (!State.PublishWorkbenchExitReview(reservation, retention, out var approval) || approval is null)
                        return "DBLC could not open the shared Workbench exit review. The Workbench remains open.";
                    return await approval;
                }
                catch (Exception ex)
                {
                    State.CancelWorkbenchExitReviewPreparation(reservation);
                    return "DBLC could not open the Workbench exit review, so the Workbench remains open. " + ex.Message;
                }
            }
            var accepted = false;
            var sendTask = State.SendAsync(prompt, Client, ServerModelId, ServerContextLimit, Paper.ReadPlayerMarkdown, Paper.ReadWorkspaceNotes, diagnostics, visionImage, imageKey,
                requestWorkbenchEnd: RequestWorkbenchEndFromGm, expectedConversationId: sourceConversation.Id,
                onAccepted: () => { accepted = true; if (fromComposer) { Draft = ""; RemoveComposerImage(); } },
                onRejected: reason => SessionActionStatus = reason, internalInstruction: internalInstruction);
            if (accepted && fromComposer)
                try { await JS.InvokeVoidAsync("clearComposer", ComposerElement); } catch { }
            else if (imageKey is not null && !State.HasChronicleImageReference(sourceConversation.CampaignId, sourceConversation.Id, imageKey)) ChronicleImages.DeleteAsset(sourceConversation.CampaignId, sourceConversation.Id, imageKey);
            await sendTask;
        }
        catch
        {
            if (imageKey is not null && !State.HasChronicleImageReference(sourceConversation.CampaignId, sourceConversation.Id, imageKey)) ChronicleImages.DeleteAsset(sourceConversation.CampaignId, sourceConversation.Id, imageKey);
            throw;
        }
    }
