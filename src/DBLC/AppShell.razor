    private void ChangePrivacyPin()
    {
        try
        {
            if (System.Windows.Application.Current.Dispatcher.Invoke(() => PinPromptWindow.Configure(Privacy))) PrivacyStatus = "Privacy PIN saved.";
        }
        catch (Exception error) { PrivacyStatus = "Could not save privacy PIN: " + error.Message; }
    }
    private void RemovePrivacyPin()
    {
        try
        {
            var choice = System.Windows.Application.Current.Dispatcher.Invoke(() => System.Windows.MessageBox.Show(
                "Remove the local privacy PIN? DBLC will open without a PIN.", "DBLC · Remove PIN",
                System.Windows.MessageBoxButton.YesNo, System.Windows.MessageBoxImage.Question));
            if (choice == System.Windows.MessageBoxResult.Yes) { Privacy.RemovePin(); PrivacyStatus = "Privacy PIN removed."; }
        }
        catch (Exception error) { PrivacyStatus = "Could not remove privacy PIN: " + error.Message; }
    }
