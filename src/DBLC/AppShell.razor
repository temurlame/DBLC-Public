                                    }
                                    <div class="message-body">
                                        @if (line.Role == "assistant" && line.PresentationSegments is { Count: > 0 } segments)
                                        {
                                            @for (var segmentIndex = 0; segmentIndex < segments.Count; segmentIndex++)
                                            {
                                                var segment = segments[segmentIndex];
                                                var showSpeakerHeader = segmentIndex == 0 || !string.Equals(segments[segmentIndex - 1].Speaker, segment.Speaker, StringComparison.OrdinalIgnoreCase);
                                                var speakerNpc = ResolveSpeakerNpc(segment);
                                                var speakerPortrait = speakerNpc is null ? null : MobileHost
                                                    ? PortraitStore.BrowserImageUrl(State.Current!.CampaignId, speakerNpc.Id, speakerNpc.PortraitExtension)
                                                    : PortraitStore.ReadDataUrl(State.Current!.CampaignId, speakerNpc.Id, speakerNpc.PortraitExtension);
                                                var liveGmResponse = State.Busy && line.Role == "assistant" && ReferenceEquals(State.Current?.Lines.LastOrDefault(), line);
                                                <div class="gm-expression-segment">
                                                    @if (showSpeakerHeader)
                                                    {
                                                        <div class="avatar speaker-avatar">
                                                            @if (string.Equals(segment.Speaker, "GM", StringComparison.OrdinalIgnoreCase)) { @(line.GmMark ?? CurrentGmMark) }
                                                            else if (speakerPortrait is not null) { <button class="speaker-portrait-button" type="button" title="View @segment.Speaker portrait" aria-label="View @segment.Speaker portrait" @onclick="() => OpenChronicleImageViewer(speakerPortrait, segment.Speaker)"><img src="@speakerPortrait" alt="" style="@NpcSpeakerPortraitStyle(speakerNpc!)" draggable="false" /></button> }
                                                            else { @IdentityInitial(segment.Speaker) }
                                                        </div>
                                                    }
                                                    else { <div class="avatar speaker-avatar speaker-avatar-spacer" aria-hidden="true"></div> }
                                                    <div class="gm-expression-content">
                                                        @if (showSpeakerHeader) { <div class="message-meta speaker-meta"><span>@(string.Equals(segment.Speaker, "GM", StringComparison.OrdinalIgnoreCase) ? "THE GM" : segment.Speaker)</span><span class="speaker-time">@(segmentIndex == 0 ? line.DisplayTimestamp.ToLocalTime().ToString("h:mm tt") : "")</span></div> }
                                                        <div class="message-content @(FlavorClass(segment.Flavor))" data-clean-text="@segment.Text"><ChronicleText @key="segment.Id" Text="@segment.Text" Flavor="@segment.Flavor" Seed="@segment.GlitchSeed" StableKey="@($"{line.Id:N}:{segment.Id:N}")" FlavorsEnabled="@State.GmFlavorFontsEnabled" AnimationsEnabled="@State.GmStreamAnimationsEnabled" DefaultEffect="@State.GmStreamDefaultEffect" InlineEffectsEnabled="@State.GmInlineStreamEffectsEnabled" EffectSpans="@segment.NarrationEffectSpans" IsLiveResponse="@liveGmResponse" /></div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="message-meta">@(line.Role == "user" ? (string.IsNullOrWhiteSpace(CurrentPlayerName) ? "YOU" : CurrentPlayerName) : "THE GM") <span>@line.DisplayTimestamp.ToLocalTime().ToString("h:mm tt")</span></div>
                                            var liveGmResponse = State.Busy && line.Role == "assistant" && ReferenceEquals(State.Current?.Lines.LastOrDefault(), line);
                                            <div class="message-content">@if (line.RollSides is not null) { @line.RollDisplayText } else { <ChronicleText Text="@line.Content" StableKey="@($"{line.Id:N}:0")" AnimationsEnabled="@State.GmStreamAnimationsEnabled" DefaultEffect="@State.GmStreamDefaultEffect" InlineEffectsEnabled="@State.GmInlineStreamEffectsEnabled" EffectSpans="@line.NarrationEffectSpans" IsLiveResponse="@liveGmResponse" /> }</div>
                                        }
                                        @if (line.Role == "user" && line.ImageAttachmentKey is { } imageKey && GetChronicleImageDataUrl(imageKey) is { } chronicleImageUrl)
                                        {
                                            <button class="chronicle-image-attachment" type="button" title="View attached image" @onclick="() => OpenChronicleImageViewer(chronicleImageUrl)"><img src="@chronicleImageUrl" alt="Image attached to this message" loading="lazy" /></button>
                                        }
                                        @if (line.Role == "assistant" && line.EntryType != ChatLine.TechnicalErrorEntryType && !string.IsNullOrWhiteSpace(line.Content) &&
                                            line.Content != "(The model returned no text.)")
                                        {
                                            <GmNoteReferences References="line.GmNoteReferences" Sources="line.SourceReferences" AllowPrivateSources="@(!MobileHost)" OnOpen="OpenGmNoteReference" OnOpenSource="OpenSourceReference" />
                                        }
                                    </div>
                                </article>
                            }
                        }
                    }
                    @if (State.Busy && (State.GmThinkingSigilEnabled || State.Current?.Lines.LastOrDefault()?.Content.Length == 0))
                    {
                        <div class="typing">
                            @if (State.GmThinkingSigilEnabled)
                            {
                                <div class="typing-avatar"><GmThinkingSigil Size="54" /></div>
                            }
                            else
                            {
                                <span></span><span></span><span></span><em>@ActivityStatus</em>
                            }
                        </div>
                    }
                    @if (State.Current?.Lines.Count > 0) { <div class="scroll-anchor"></div> }
                    </div>
                </div>
                <button @ref="ChronicleJumpButtonElement" class="chronicle-jump-button" type="button" aria-label="Jump to latest" title="Jump to latest" aria-hidden="true" tabindex="-1" @onclick="JumpToLatest"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v15m-6-6 6 6 6-6" /></svg></button>
                </div>
                <form class="composer" @ref="ComposerFormElement" data-vision-enabled="@State.VisionEnabled.ToString().ToLowerInvariant()" data-busy="@((State.Busy || ResolvingModel).ToString().ToLowerInvariant())" @onsubmit="SendForm" @onsubmit:preventDefault>
                    @if (State.VisionEnabled)
                    {
                        <InputFile id="composer-image-picker" class="composer-image-picker" OnChange="SelectComposerImage" accept="image/png,image/jpeg,.png,.jpg,.jpeg" disabled="@(State.Busy || ResolvingModel || State.Current?.IsEnded == true)" />
                        @if (ComposerImage is { } attached)
                        {
                            <div class="composer-image-preview"><img src="@ComposerImageDataUrl" alt="Attached image preview" /><span title="@attached.Name">@attached.Name</span><button type="button" aria-label="Remove attached image" title="Remove image" @onclick="RemoveComposerImage">×</button></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(ComposerImageError)) { <div class="composer-image-error">@ComposerImageError</div> }
                    }
                    <div class="composer-input-row">
                        <textarea @ref="ComposerElement" @bind="Draft" @bind:event="oninput" placeholder="@(State.Current?.IsEnded == true ? "This session has ended." : "Ask the GM…")" rows="1" disabled="@((State.Busy && !State.CanSteerCurrentResponse) || ResolvingModel || SessionActionBusy || State.Current?.IsEnded == true)"></textarea>
                        <div class="composer-actions">
                            @if (State.VisionEnabled)
                            {
                                <button class="composer-attach-button" type="button" title="Attach PNG or JPEG" aria-label="Attach image" disabled="@(State.Busy || ResolvingModel || State.Current?.IsEnded == true)" @onclick="OpenComposerImagePicker"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 11.1 11.2 20.3a5.2 5.2 0 0 1-7.4-7.4l9.3-9.3a3.5 3.5 0 0 1 5 5l-9.3 9.3a1.8 1.8 0 0 1-2.5-2.5l8.8-8.8" /></svg></button>
                            }
                            <DiceRoller @bind-SelectedSides="SelectedDieSides" Disabled="@DiceControlsDisabled" ConversationId="@(State.Current?.Id)" OnRoll="RecordPlayerRoll" />
                            <span class="composer-action-divider"></span>
                            <button class="send-button send-icon-button @(State.Busy && string.IsNullOrWhiteSpace(Draft) ? "stop-generating" : "")" type="submit" aria-label="@(State.Busy && string.IsNullOrWhiteSpace(Draft) ? "Stop generation" : "Send message")" title="@(State.Busy && string.IsNullOrWhiteSpace(Draft) ? "Stop generation" : State.Busy ? "Steer the GM" : "Send")" disabled="@((State.Busy && !State.CanSteerCurrentResponse) || ResolvingModel || SessionActionBusy || State.Current?.IsEnded == true)">
                                @if (State.Busy && string.IsNullOrWhiteSpace(Draft))
                                {
                                    <svg viewBox="0 0 28 28" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="1" /></svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 28 28" aria-hidden="true"><path d="M3 14h19M14 6l9 8-9 8" /></svg>
                                }
                            </button>
                        </div>
                    </div>
                </form>
                <div class="context-meter-wrap">
                    <div class="context-meter-track" role="progressbar" aria-label="Model context usage" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@ContextPercent" title="@ContextTooltip">
                        <div class="context-meter-fill" style="width:@ContextFillWidth"></div>
                    </div>
                    <div class="context-meter-tooltip"><span>@ContextTooltip</span><b>@(State.Current?.IsWorkbench == true ? "Workbench context is separate from the parent Session and is discarded when you end it." : "At ~80%, DBLC summarizes older messages and keeps the originals available to the GM.")</b></div>
                </div>
            </section>

            <aside class="library-pane">
                <div class="library-tabs" role="tablist" aria-label="Reference pane">
                    <button class="library-tab @(RightPaneTab == "Library" ? "selected" : "")" role="tab" aria-selected="@(RightPaneTab == "Library")" @onclick="ShowLibraryTab">Library</button>
                    <button class="library-tab @(RightPaneTab == "NPCs" ? "selected" : "")" role="tab" aria-selected="@(RightPaneTab == "NPCs")" @onclick="ShowNpcTab">NPCs <span>@State.GetNpcs(State.ActiveCampaignId).Count</span></button>
                    <button class="library-tab @(RightPaneTab == "Agenda" ? "selected" : "")" role="tab" aria-selected="@(RightPaneTab == "Agenda")" @onclick="ShowAgendaTab">Agenda</button>
                    <button class="library-tab @(RightPaneTab == "Bestiary" ? "selected" : "")" role="tab" aria-selected="@(RightPaneTab == "Bestiary")" @onclick="ShowBestiaryTab">Bestiary <span>@State.GetBestiary(State.ActiveCampaignId).Count</span></button>
                    <button class="library-tab @(RightPaneTab == "Maps" ? "selected" : "")" role="tab" aria-selected="@(RightPaneTab == "Maps")" @onclick="ShowMapsTab">Maps</button>
                </div>
                @if (RightPaneTab == "NPCs")
                {
                    <div class="panel-heading npc-panel-heading"><div><div class="eyebrow">CAMPAIGN NOTES</div><h2>NPCs</h2></div><span class="book-count">@State.GetNpcs(State.ActiveCampaignId).Count.ToString("00")</span></div>
                    @if (EditingNpc is not null || CreatingNpc)
                    {
                        <div class="npc-editor">
                            <button class="text-button npc-back" @onclick="CloseNpcEditor">‹ Back to NPCs</button>
                            <section class="npc-portrait-card" aria-label="NPC portrait">
                                @if (!string.IsNullOrWhiteSpace(EditingNpcPortraitUrl) && !NpcPortraitPositioning)
                                {
                                    <button class="npc-portrait-image-button" title="View original portrait" @onclick="OpenPortraitViewer"><img class="npc-portrait-image" src="@EditingNpcPortraitUrl" alt="Portrait of @NpcNameDraft" style="@NpcPortraitImageStyle" /></button>
                                }
                                else if (!string.IsNullOrWhiteSpace(EditingNpcPortraitUrl))
                                {
                                    <div class="npc-portrait-position-frame" @ref="NpcPortraitPositionFrameElement" data-x="@NpcPortraitFrame.X" data-y="@NpcPortraitFrame.Y" data-zoom="@NpcPortraitFrame.Zoom"><img class="npc-portrait-image" src="@EditingNpcPortraitUrl" alt="Adjust portrait framing" style="@NpcPortraitImageStyle" draggable="false" /></div>
                                }
                                else
                                {
                                    <div class="npc-portrait-placeholder" aria-label="No portrait uploaded">@NpcInitial(NpcNameDraft)</div>
                                }
                                <div class="npc-portrait-actions">
                                    @if (MobileHost) { <label class="outline-button mobile-file-button">@(string.IsNullOrWhiteSpace(EditingNpcPortraitUrl) ? "Upload Portrait" : "Change Portrait")<InputFile accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" OnChange="UploadNpcPortrait" /></label> }
                                    else { <button class="outline-button" @onclick="ChooseNpcPortrait">@(string.IsNullOrWhiteSpace(EditingNpcPortraitUrl) ? "Upload Portrait" : "Change Portrait")</button> }
                                    @if (!string.IsNullOrWhiteSpace(EditingNpcPortraitUrl))
                                    {
                                        <button class="outline-button" @onclick="ToggleNpcPortraitPosition">@(NpcPortraitPositioning ? "Done" : "Position")</button>
                                        @if (NpcPortraitPositioning)
                                        {
                                            <label class="npc-portrait-zoom">Zoom <input type="range" min="1" max="8" step="0.05" value="@NpcPortraitFrame.Zoom" @oninput="ChangeNpcPortraitZoom" /></label>
                                            <span class="npc-portrait-position-hint">Drag the portrait inside its frame.</span>
                                        }
                                        <button class="text-button npc-remove-portrait" @onclick="RemoveNpcPortrait">Remove Portrait</button>
                                    }
                                </div>
                            </section>
                            <label>Name<input @bind="NpcNameDraft" @bind:event="oninput" maxlength="100" placeholder="NPC name" /></label>
                            <label>Notes<textarea @bind="NpcNotesDraft" @bind:event="oninput" placeholder="Freeform notes…"></textarea></label>
                            <label>Portrayal Cue <span class="field-hint">Optional casting note for voice, demeanor, quirks, or brief example dialogue. Keep secrets and history in Notes.</span><textarea @bind="NpcPortrayalCueDraft" @bind:event="oninput" maxlength="1200" placeholder="How should the GM portray this NPC?" aria-label="NPC portrayal cue"></textarea></label>
                            <div class="npc-cue-count">@NpcPortrayalCueDraft.Length / 1,200</div>
                            @if (!string.IsNullOrWhiteSpace(NpcEditorStatus)) { <div class="npc-editor-status">@NpcEditorStatus</div> }
                            <div class="npc-editor-actions"><button class="outline-button" @onclick="SaveNpcEditor">Save</button>@if (EditingNpc is not null) { <button class="outline-button danger-button" @onclick="AskDeleteNpc">Delete</button> }</div>
                        </div>
                    }
                    else
                    {
                        <label class="npc-search"><span aria-hidden="true">⌕</span><input @bind="NpcSearch" @bind:event="oninput" placeholder="Search NPCs..." aria-label="Search NPCs" /></label>
                        <button class="npc-create-button" @onclick="BeginCreateNpc"><span>＋</span> New NPC</button>
                        <div class="npc-list" aria-label="NPC cards">
                            @foreach (var npc in FilteredNpcs)
                            {
                                <button @key="npc.Id" class="npc-list-item" @onclick="() => OpenNpc(npc)">@npc.Name<span>›</span></button>
                            }
                            @if (!FilteredNpcs.Any()) { <div class="npc-empty">@(string.IsNullOrWhiteSpace(NpcSearch) ? "No NPCs yet." : "No matching NPCs.")</div> }
                        </div>
                        <div class="library-foot npc-foot"><span>NPC cards belong to this campaign and are shared with the GM.</span></div>
                    }
                }
                else if (RightPaneTab == "Agenda")
                {
                    var agendaCampaign = State.ActiveCampaign;
                    var campaignMinute = agendaCampaign?.Clock?.TotalMinutes ?? 8 * 60;
                    var dateTimeSettings = agendaCampaign?.DateTimeSettings;
                    var playerEvents = State.GetPlayerAgenda(State.ActiveCampaignId);
                    var upcomingEvents = playerEvents.Where(item => item.Status == "upcoming").OrderBy(item => item.DueMinute).ToList();
                    var recentEvents = playerEvents.Where(item => item.Status is "reached" or "resolved")
                        .OrderByDescending(item => item.Status == "resolved" ? item.ResolvedAtMinute ?? item.DueMinute : item.ReachedAtMinute ?? item.DueMinute).Take(6).ToList();
                    EnsureAgendaCalendarView(dateTimeSettings);
                    var currentCampaignDay = CampaignAgendaFormat.Day(campaignMinute);
                    var hasCalendarPage = CampaignCalendar.TryGetMonthPage(dateTimeSettings, currentCampaignDay, AgendaMonthOffset, out var calendarPage);
                    var playerEventsByDay = playerEvents.GroupBy(item => CampaignAgendaFormat.Day(item.DueMinute))
                        .ToDictionary(group => (long)group.Key, group => group.OrderBy(item => item.DueMinute).ToList());
                    <div class="panel-heading agenda-panel-heading"><div><div class="eyebrow">CAMPAIGN TIME</div><h2>Agenda</h2></div></div>
                    <section class="agenda-now"><div class="agenda-section-label">NOW</div><div class="agenda-current-day">@CampaignCalendar.DateLabel(dateTimeSettings, campaignMinute)</div>@if (dateTimeSettings?.UniversalTimeEnabled != false) { <div class="agenda-current-time">@CampaignAgendaFormat.Daypart(campaignMinute) · @CampaignAgendaFormat.ClockTime(campaignMinute)</div> }</section>
                    @if (hasCalendarPage && calendarPage is not null)
                    {
                        var monthPage = calendarPage;
                        <section class="agenda-calendar" aria-label="Campaign calendar">
                            <div class="agenda-calendar-heading"><div class="agenda-section-label">CALENDAR</div><button class="outline-button agenda-calendar-today" @onclick="AgendaCalendarToday">Today</button></div>
                            <div class="agenda-calendar-navigation"><button class="agenda-calendar-arrow" aria-label="Previous month" title="Previous month" @onclick="() => NavigateAgendaMonth(-1)">‹</button><strong>@monthPage.Title</strong><button class="agenda-calendar-arrow" aria-label="Next month" title="Next month" @onclick="() => NavigateAgendaMonth(1)">›</button></div>
                            <div class="agenda-calendar-scroll"><div class="agenda-calendar-grid" style="--agenda-weekdays:@monthPage.Weekdays.Count">
                                @foreach (var weekday in monthPage.Weekdays) { <span class="agenda-calendar-weekday" title="@weekday">@weekday</span> }
                                @for (var blank = 0; blank < monthPage.FirstWeekdayIndex; blank++) { <span class="agenda-calendar-blank" aria-hidden="true"></span> }
                                @for (var number = 1; number <= monthPage.Days; number++)
                                {
                                    var day = monthPage.FirstCampaignDay + number - 1;
                                    var isToday = day == currentCampaignDay;
                                    var isSelected = day == SelectedAgendaDay;
                                    var hasEvents = playerEventsByDay.ContainsKey(day);
                                    <button @key="day" class="agenda-calendar-day @(isToday ? "today" : "") @(isSelected ? "selected" : "")" aria-label="@($"{monthPage.Title}, day {number}{(isToday ? ", today" : "")}{(hasEvents ? ", scheduled events" : "")}")" aria-pressed="@isSelected" disabled="@(day < 1)" @onclick="() => SelectAgendaDay(day)"><span>@number</span>@if (hasEvents) { <i aria-hidden="true"></i> }</button>
                                }
                            </div></div>
                            @if (SelectedAgendaDay is { } selectedDay && monthPage.ContainsCampaignDay(selectedDay))
                            {
                                <div class="agenda-calendar-selected"><div class="agenda-section-label">@monthPage.Title · Day @(selectedDay - monthPage.FirstCampaignDay + 1)</div>
                                    @if (playerEventsByDay.TryGetValue(selectedDay, out var dayEvents))
                                    {
                                        @foreach (var item in dayEvents) { <article class="agenda-item"><div class="agenda-item-time">@CampaignCalendar.EventDate(dateTimeSettings, item.DueMinute, campaignMinute) · @item.Status</div><div class="agenda-item-title">@item.Title</div></article> }
                                    }
                                    else { <div class="agenda-empty">No scheduled events on this day.</div> }
                                </div>
                            }
                        </section>
                    }
                    <section class="agenda-section"><div class="agenda-section-label">UPCOMING</div>
                        @if (upcomingEvents.Count == 0) { <div class="agenda-empty">No upcoming events.</div> }
                        else { @foreach (var item in upcomingEvents) { <article class="agenda-item"><div class="agenda-item-time">@CampaignCalendar.EventDate(dateTimeSettings, item.DueMinute, campaignMinute)</div><div class="agenda-item-title">@item.Title</div></article> } }
                    </section>
                    <section class="agenda-section agenda-recent"><div class="agenda-section-label">RECENT</div>
                        @if (recentEvents.Count == 0) { <div class="agenda-empty">No recent events.</div> }
                        else { @foreach (var item in recentEvents) { var eventMinute = item.Status == "resolved" ? item.ResolvedAtMinute ?? item.DueMinute : item.ReachedAtMinute ?? item.DueMinute; <article class="agenda-item"><div class="agenda-item-time">@CampaignCalendar.EventDate(dateTimeSettings, eventMinute, campaignMinute) · @(item.Status == "resolved" ? "Resolved" : "Reached")</div><div class="agenda-item-title">@item.Title</div></article> } }
                    </section>
                }
                else if (RightPaneTab == "Maps")
                {
                    var importedMaps = State.GetMapDisplayEntries(State.ActiveCampaignId);
                    <div class="panel-heading maps-panel-heading"><div><div class="eyebrow">CAMPAIGN MAPS</div><h2>Maps</h2></div></div>
                    <section class="maps-saved-section">
                        <div class="agenda-section-label">IMPORTED IMAGES <span>@importedMaps.Count.ToString("00")</span></div>
                        @if (!MobileHost) { <button class="outline-button maps-import-button" @onclick="ImportMapImage">Import map image</button> }
                        @if (!string.IsNullOrWhiteSpace(ImportedMapStatus)) { <div class="map-ui-status">@ImportedMapStatus</div> }
                        @if (importedMaps.Count == 0) { <div class="agenda-empty">No imported map images are available.</div> }
                        else
                        {
                            <div class="maps-saved-list">
                                @foreach (var map in importedMaps)
                                {
                                    <div @key="map.Id" class="maps-saved-row maps-imported-row">
                                        <button class="maps-saved-item" title="Open @map.Title" @onclick="() => OpenImportedMap(map)">
                                            <img class="maps-imported-thumb" src="@ImportedMapImageUrl(map, "thumbnail")" alt="" loading="lazy" />
                                            <span><strong>@map.Title</strong><small>@map.Width × @map.Height</small></span><b>›</b>
                                        </button>
                                        @if (!MobileHost) { <button class="maps-delete-button" title="Manage @map.Title" aria-label="Manage @map.Title" @onclick="() => EditImportedMap(map.Id)">⋯</button> }
                                    </div>
                                }
                            </div>
                        }
                    </section>
                    <div class="library-foot npc-foot"><span>Imported maps are visual references.</span></div>
                }
                else if (RightPaneTab == "Bestiary")
                {
                    var bestiaryEntries = FilteredBestiary.ToList();
                    <div class="panel-heading npc-panel-heading"><div><div class="eyebrow">CAMPAIGN FIELD GUIDE</div><h2>Bestiary</h2></div><span class="book-count">@State.GetBestiary(State.ActiveCampaignId).Count.ToString("00")</span></div>
                    @if (CreatingBestiary || EditingBestiaryContent)
                    {
                        <div class="npc-editor bestiary-editor">
                            <button class="text-button npc-back" @onclick="CloseBestiaryEditor">‹ Back to Bestiary</button>
                            @if (BestiaryPositioning && !string.IsNullOrWhiteSpace(BestiaryPortraitUrl))
                            {
                                <div class="npc-portrait-position-frame bestiary-editor-position-frame" @ref="BestiaryPortraitPositionFrameElement" data-x="@BestiaryPortraitFrame.X" data-y="@BestiaryPortraitFrame.Y" data-zoom="@BestiaryPortraitFrame.Zoom"><img class="npc-portrait-image" src="@BestiaryPortraitUrl" alt="Adjust Bestiary portrait framing" style="@BestiaryPortraitImageStyle" draggable="false" /></div>
                            }
                            else if (ActiveBestiary is { } bestiaryBeingEdited)
                            {
                                <BestiaryCardView Entry="bestiaryBeingEdited" PortraitDataUrl="@BestiaryPortraitUrl" Frame="BestiaryPortraitFrame" OnPortraitClick="OpenBestiaryPortraitViewer" />
                            }
                            else
                            {
                                <div class="npc-portrait-card"><div class="npc-portrait-placeholder">@(string.IsNullOrWhiteSpace(BestiaryNameDraft) ? "?" : BestiaryNameDraft.Trim()[0].ToString().ToUpperInvariant())</div></div>
                            }
                            <div class="npc-portrait-actions">
                                @if (MobileHost) { <label class="outline-button mobile-file-button">@(string.IsNullOrWhiteSpace(BestiaryPortraitUrl) ? "Upload Portrait" : "Change Portrait")<InputFile accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" OnChange="UploadBestiaryPortrait" /></label> }
                                else { <button class="outline-button" @onclick="ChooseBestiaryPortrait">@(string.IsNullOrWhiteSpace(BestiaryPortraitUrl) ? "Upload Portrait" : "Change Portrait")</button> }
                                @if (!string.IsNullOrWhiteSpace(BestiaryPortraitUrl))
                                {
                                    <button class="outline-button" @onclick="ToggleBestiaryPortraitPosition">@(BestiaryPositioning ? "Done" : "Position")</button>
                                    @if (BestiaryPositioning)
                                    {
                                        <label class="npc-portrait-zoom">Zoom <input type="range" min="1" max="8" step="0.05" value="@BestiaryPortraitFrame.Zoom" @oninput="ChangeBestiaryPortraitZoom" /></label>
                                        <span class="npc-portrait-position-hint">Drag the portrait inside its frame.</span>
                                    }
                                    <button class="text-button npc-remove-portrait" @onclick="RemoveBestiaryPortrait">Remove Portrait</button>
                                }
                            </div>
                            <label>Name<input @bind="BestiaryNameDraft" @bind:event="oninput" maxlength="100" placeholder="Creature type" /></label>
                            <label>Stat Block<textarea class="bestiary-stat-editor" @bind="BestiaryStatBlockDraft" @bind:event="oninput" placeholder="Standard reference stat block…"></textarea></label>
                            <label>Campaign Notes<textarea @bind="BestiaryNotesDraft" @bind:event="oninput" placeholder="What the party has learned…"></textarea></label>
                            @if (!string.IsNullOrWhiteSpace(BestiaryEditorStatus)) { <div class="npc-editor-status">@BestiaryEditorStatus</div> }
                            <div class="npc-editor-actions bestiary-editor-actions"><button class="outline-button" @onclick="SaveBestiaryEditor">Save</button>@if (ActiveBestiary is not null) { <button class="outline-button danger-button" @onclick="AskDeleteBestiary">Delete</button> }</div>
                        </div>
                    }
                    else if (ActiveBestiary is { } selectedBestiary)
                    {
                        <div class="bestiary-detail">
                            <button class="text-button npc-back" @onclick="CloseBestiaryDetail">‹ Back to Bestiary</button>
                            <BestiaryCardView Entry="selectedBestiary" PortraitDataUrl="@BestiaryPortraitUrl" Frame="BestiaryPortraitFrame" OnPortraitClick="OpenBestiaryPortraitViewer" />
                            <div class="bestiary-detail-actions"><button class="outline-button" @onclick="BeginEditBestiary">Edit Card</button><button class="outline-button" @onclick="IncrementSelectedBestiary">+ Slain</button><button class="outline-button" @onclick="DecrementSelectedBestiary" disabled="@(selectedBestiary.Slain == 0)">− Slain</button></div>
                            @if (!string.IsNullOrWhiteSpace(BestiaryEditorStatus)) { <div class="npc-editor-status">@BestiaryEditorStatus</div> }
                            <div class="npc-portrait-actions">@if (MobileHost) { <label class="outline-button mobile-file-button">@(string.IsNullOrWhiteSpace(BestiaryPortraitUrl) ? "Upload Portrait" : "Change Portrait")<InputFile accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" OnChange="UploadBestiaryPortrait" /></label> } else { <button class="outline-button" @onclick="ChooseBestiaryPortrait">@(string.IsNullOrWhiteSpace(BestiaryPortraitUrl) ? "Upload Portrait" : "Change Portrait")</button> }@if (!string.IsNullOrWhiteSpace(BestiaryPortraitUrl)) { <button class="outline-button" @onclick="ToggleBestiaryPortraitPosition">@(BestiaryPositioning ? "Done" : "Position")</button><button class="text-button npc-remove-portrait" @onclick="RemoveBestiaryPortrait">Remove Portrait</button> }</div>
                            @if (BestiaryPositioning && !string.IsNullOrWhiteSpace(BestiaryPortraitUrl))
                            {
                                <div class="npc-portrait-position-frame bestiary-detail-position-frame" @ref="BestiaryPortraitPositionFrameElement" data-x="@BestiaryPortraitFrame.X" data-y="@BestiaryPortraitFrame.Y" data-zoom="@BestiaryPortraitFrame.Zoom"><img class="npc-portrait-image" src="@BestiaryPortraitUrl" alt="Adjust Bestiary portrait framing" style="@BestiaryPortraitImageStyle" draggable="false" /></div>
                                <label class="npc-portrait-zoom">Zoom <input type="range" min="1" max="8" step="0.05" value="@BestiaryPortraitFrame.Zoom" @oninput="ChangeBestiaryPortraitZoom" /></label><span class="npc-portrait-position-hint">Drag the portrait inside its frame.</span>
                            }
                        </div>
                    }
                    else
                    {
                        <label class="npc-search"><span aria-hidden="true">⌕</span><input @bind="BestiarySearch" @bind:event="oninput" placeholder="Search Bestiary…" aria-label="Search Bestiary" /></label>
                        <button class="npc-create-button" @onclick="BeginCreateBestiary"><span>＋</span> New Entry</button>
                        <div class="npc-list" aria-label="Bestiary entries">
                            @foreach (var entry in bestiaryEntries)
                            {
                                <button @key="entry.Id" class="npc-list-item bestiary-list-item" @onclick="() => OpenBestiary(entry)"><span class="bestiary-list-name">@entry.Name</span><small>Slain @entry.Slain</small></button>
                            }
                            @if (bestiaryEntries.Count == 0) { <div class="npc-empty">@(string.IsNullOrWhiteSpace(BestiarySearch) ? "No creature types yet." : "No matching Bestiary entries.")</div> }
                        </div>
                        <div class="library-foot npc-foot"><span>Creature-type reference cards, kept with this campaign.</span></div>
                    }
                }
                else
                {
                <div class="panel-heading"><div><div class="eyebrow">REFERENCE LIBRARY</div><h2>Library shelf</h2></div><span class="book-count">@State.Books.Count.ToString("00")</span></div>
                <div class="library-controls"><span>@(State.Books.Count == 1 ? "1 PDF BOOK" : $"{State.Books.Count} PDF BOOKS")</span><button class="text-button" @onclick="PickFolder">Choose folder</button></div>
                @if (!string.IsNullOrWhiteSpace(LibraryStatus)) { <div class="npc-editor-status">@LibraryStatus</div> }
                @if (State.Books.Count == 0)
                {
                    <div class="empty-library"><div class="empty-mark">⌂</div><h3>No PDF books found</h3><p>Choose a folder containing one or more PDF books.</p><button class="outline-button" @onclick="PickFolder">Choose library folder</button></div>
                }
                else
                {
                    <div class="book-shelf">
                        @foreach (var book in State.Books)
                        {
                            <button class="shelf-book @(State.PdfPath == book.Path ? "selected" : "")" @onclick="() => SelectBook(book.Path)" title="@(MobileHost ? book.Title : book.Path)">
                                <span class="shelf-book-mark">▤</span><span class="shelf-book-copy"><strong>@book.Title</strong><small>@(book.PageCount is null ? "Pages unknown" : $"{book.PageCount} pages") · @(book.Error is null ? book.BookmarkCount == 0 ? "No bookmarks" : $"{book.BookmarkCount} bookmarks" : "Could not read PDF")</small>@if (!MobileHost) { <small class="shelf-book-path">@Path.GetDirectoryName(book.Path)</small> }</span><span class="shelf-arrow">›</span>
                            </button>
                        }
                    </div>
                    @if (State.SelectedBook is { } selected)
                    {
                        <div class="selected-book-info"><div class="book-info"><div class="book-title">@selected.Title</div><div class="book-edition">@(selected.PageCount is null ? "PDF could not be read" : $"{selected.PageCount} PDF pages")</div>@if (!MobileHost) { <div class="book-loc" title="@selected.Path"><span>⌖</span> @selected.Path</div> }</div>@if (MobileHost) { <a class="text-button mobile-pdf-link" href="/library/@Uri.EscapeDataString(selected.Id)" target="_blank" rel="noopener">Open PDF ↗</a> } else { <button class="text-button" @onclick="OpenPdf">Open in PDF viewer ↗</button> }</div>
                        <div class="catalogue-wrap">
                            <div class="catalogue-heading"><span>BOOKMARK CATALOGUE</span><span class="catalogue-count">@selected.BookmarkCount</span></div>
                            @if (selected.Error is not null)
                            {
                                <div class="catalogue-note">This PDF could not be read: @selected.Error</div>
                            }
                            else if (selected.BookmarkCount == 0)
                            {
                                <div class="catalogue-note">No bookmarks in this book. The GM can still request page ranges.</div>
                            }
                            else
                            {
                                <div class="catalogue-note">Select a book to view its bookmarks. The GM chooses what to read.</div>
                                <div class="toc-list shelf-catalogue">
                                    @foreach (var entry in Catalogue.Take(10))
                                    {
                                        <div class="toc-row" style="padding-left:@(8 + entry.Depth * 11)px"><span>@entry.Title</span><span class="toc-page">@(entry.Page is null ? "···" : $"{entry.Page:00}")</span></div>
                                    }
                                    @if (Catalogue.Count > 10) { <button class="text-button more-toc" @onclick="ShowCatalogue">See all @Catalogue.Count bookmarks →</button> }
                                </div>
                            }
                        </div>
                    }
                }
                <div class="library-rule"></div>
                <div class="library-foot"><span class="lock-mark">▣</span><span>Library stays on this device.<br/><b>Only requested pages go to the GM.</b></span></div>
                }
            </aside>
            }
        </div>
    </main>
</div>

@if (!string.IsNullOrWhiteSpace(CatalogueText))
{
    <div class="modal-backdrop" @onclick="CloseCatalogue">
        <section class="catalogue-modal" @onclick:stopPropagation>
            <div class="modal-top"><div><div class="eyebrow">BOOKMARKS · @State.SelectedBook?.Title</div><h2>Book catalogue</h2></div><button class="icon-button" @onclick="CloseCatalogue">×</button></div>
            <div class="modal-catalogue">@foreach (var entry in Catalogue) { <div class="toc-row" style="padding-left:@(14 + entry.Depth * 18)px"><span>@entry.Title</span><span class="toc-page">@(entry.Page is null ? "" : $"PDF p. {entry.Page}")</span></div> }</div>
            <p class="modal-note">This catalogue is available to the GM. The GM requests the pages it decides to read.</p>
        </section>
    </div>
}
@if (CitedArchiveSource is { } citedArchive)
{
    <div class="modal-backdrop" @onclick="() => CitedArchiveSource = null">
        <section class="catalogue-modal" role="dialog" aria-modal="true" aria-label="Archived Chronicle excerpt" @onclick:stopPropagation>
            <div class="modal-top"><div><div class="eyebrow">ARCHIVED CHRONICLE</div><h2>@citedArchive.Title</h2></div><button class="icon-button" aria-label="Close excerpt" @onclick="() => CitedArchiveSource = null">×</button></div>
            <div class="modal-catalogue">
                @foreach (var archivedLine in State.GetCitedArchiveExcerpt(citedArchive))
                {
                    <div class="source-excerpt-line"><strong>@(archivedLine.EntryType == "campaign_record" ? "CAMPAIGN RECORD" : archivedLine.Role == "user" ? "PLAYER" : "THE GM")</strong><div>@archivedLine.ContextContent</div></div>
                }
            </div>
        </section>
    </div>
}


@if (HoveredSession is { SessionSummary.Length: > 0 } hovered)
{
    <aside class="session-summary-hover" style="left:max(250px,min(@(HoverX)px,calc(100vw - 360px)));top:min(@(HoverY)px,calc(100vh - 290px))" @onmouseenter="CancelHideSessionSummary" @onmouseleave="ScheduleHideSessionSummary">
        <div class="session-summary-hover-heading"><span>SESSION @(hovered.SessionNumber ?? 1) SUMMARY</span>@if (IsSummaryStale(hovered)) { <small>OLDER RECAP</small> }</div>
        <div class="session-summary-hover-copy"><ChronicleText Text="@hovered.SessionSummary" /></div>
    </aside>
}
@if (MenuSession is { } menuSession)
{
    <div class="session-menu-backdrop" @onclick="CloseSessionMenu" @oncontextmenu:preventDefault>
        <div class="session-context-menu" style="left:min(@(MenuX)px,calc(100vw - 190px));top:min(@(MenuY)px,calc(100vh - 210px))" @onclick:stopPropagation>
            <button @onclick="BeginRenameSession">Rename</button>
            <button @onclick="DuplicateSession">Duplicate</button>
            <button @onclick="ExportSession">Export</button>
            <div></div>
            <button class="danger-action" @onclick="ConfirmDeleteSession">Delete</button>
        </div>
    </div>
}
@if (RenamingSession is { } renameSession)
{
    <div class="modal-backdrop" @onclick="CloseRenameSession">
        <section class="session-dialog" @onclick:stopPropagation>
            <div class="modal-top"><div><div class="eyebrow">SESSION @(renameSession.SessionNumber ?? 1)</div><h2>Rename session</h2></div><button class="icon-button" @onclick="CloseRenameSession">×</button></div>
            <label class="session-dialog-label">Session name<input @bind="RenameDraft" @bind:event="oninput" @onkeydown="HandleRenameKey" /></label>
            <div class="session-dialog-actions"><button class="outline-button" @onclick="CloseRenameSession">Cancel</button><button class="primary-button small" @onclick="SaveSessionRename">Save name</button></div>
        </section>
    </div>
}
@if (DeletingSession is { } deletingSession)
{
    <div class="modal-backdrop" @onclick="CancelDeleteSession">
        <section class="session-dialog" @onclick:stopPropagation>
            <div class="modal-top"><div><div class="eyebrow">SESSION @(deletingSession.SessionNumber ?? 1)</div><h2>Delete this session?</h2></div><button class="icon-button" @onclick="CancelDeleteSession">×</button></div>
            <p class="session-delete-copy">“@deletingSession.Title” and its saved chronicle archive will be permanently removed from this device.</p>
            <div class="session-dialog-actions"><button class="outline-button" @onclick="CancelDeleteSession">Cancel</button><button class="primary-button small danger-button" @onclick="DeleteSession">Delete session</button></div>
        </section>
    </div>
}
@if (ShowWorkbenchCreate)
{
    <div class="modal-backdrop" @onclick="CloseWorkbenchCreate">
        <section class="session-dialog workbench-create-dialog" role="dialog" aria-modal="true" aria-label="Create Workbench" @onclick:stopPropagation>
            <div class="modal-top"><div><div class="eyebrow">SESSION @(CurrentParentSession?.SessionNumber ?? 1)</div><h2>New Workbench</h2></div><button class="icon-button" @onclick="CloseWorkbenchCreate">×</button></div>
            <label class="session-dialog-label">Workbench name<input @bind="WorkbenchNameDraft" @bind:event="oninput" maxlength="80" placeholder="OOC · Player agency" /></label>
            <div class="session-dialog-actions"><button class="outline-button" @onclick="CloseWorkbenchCreate">Cancel</button><button class="primary-button small" @onclick="CreateWorkbench" disabled="@string.IsNullOrWhiteSpace(WorkbenchNameDraft)">Create Workbench</button></div>
        </section>
    </div>
}
@if (!MobileHost && State.PendingWorkbenchCreation is { } workbenchRequest)
{
    <div class="modal-backdrop">
        <section class="session-dialog workbench-exit-dialog" role="dialog" aria-modal="true" aria-label="Workbench request">
            <div class="modal-top"><div><div class="eyebrow">GM REQUEST</div><h2>Open “@workbenchRequest.Name”?</h2></div></div>
            <p class="workbench-exit-copy">The GM would like to move this discussion into a temporary Workbench. Your Session Chronicle will stay separate.</p>
            <div class="session-dialog-actions"><button class="outline-button" @onclick="() => State.ResolveWorkbenchCreation(workbenchRequest.Id, false)">Stay in Session</button><button class="primary-button small" @onclick="() => State.ResolveWorkbenchCreation(workbenchRequest.Id, true)">Open Workbench</button></div>
        </section>
    </div>
}
@if (!MobileHost && State.PendingWorkbenchExitReview is { } workbenchExit)
{
    <div class="modal-backdrop" @onclick="() => CancelWorkbenchExit(workbenchExit)">
        <section class="session-dialog workbench-exit-dialog" role="dialog" aria-modal="true" aria-label="End Workbench" @onclick:stopPropagation>
            <div class="modal-top"><div><div class="eyebrow">@workbenchExit.Name</div><h2>End Workbench</h2></div><button class="icon-button" title="Cancel and stay in Workbench" @onclick="() => CancelWorkbenchExit(workbenchExit)">×</button></div>
            @if (workbenchExit.Artifacts.Count > 0)
            {
                <div class="workbench-exit-label">ALREADY RETAINED</div><ul class="workbench-artifacts">@foreach (var artifact in workbenchExit.Artifacts) { <li>✓ @artifact</li> }</ul>
            }
            @if (workbenchExit.Retention.ChronicleFacts.Count == 0)
            {
                <div class="workbench-exit-label">RETAIN IN CHRONICLE</div><p class="workbench-exit-copy">No established fictional facts will be retained.</p>
            }
            else
            {
                <div class="workbench-exit-label">RETAIN IN CHRONICLE</div>
                <div class="workbench-proposed-notes">@foreach (var fact in workbenchExit.Retention.ChronicleFacts) { <blockquote>@fact</blockquote> }</div>
            }
            @if (workbenchExit.Retention.Notes.Count == 0)
            {
                <div class="workbench-exit-label">GM NOTES</div><p class="workbench-exit-copy">No GM Notes will be retained.</p>
            }
            else
            {
                <div class="workbench-exit-label">SAVING @workbenchExit.Retention.Notes.Count ITEM@(workbenchExit.Retention.Notes.Count == 1 ? "" : "S") TO GM NOTES</div>
                <div class="workbench-proposed-notes">@foreach (var note in workbenchExit.Retention.Notes) { <blockquote>@note</blockquote> }</div>
            }
            <div class="workbench-discard-copy">Saved campaign artifacts are unaffected.<br />If you approve or discard, the Workbench will close after the GM reply completes.</div>
            <div class="session-dialog-actions"><button class="outline-button" @onclick="() => CancelWorkbenchExit(workbenchExit)">Cancel</button><button class="outline-button discard-workbench-button" @onclick="() => DiscardWorkbenchFromReview(workbenchExit)">Discard &amp; Exit</button><button class="primary-button small" @onclick="() => ConfirmEndWorkbench(workbenchExit)">@(workbenchExit.Retention.Notes.Count == 0 && workbenchExit.Retention.ChronicleFacts.Count == 0 ? "End & Return" : "End & Save")</button></div>
        </section>
    </div>
}

@if (NpcPendingDelete is { } deletingNpc)
{
    <div class="modal-backdrop" @onclick="CancelDeleteNpc">
        <section class="session-dialog" @onclick:stopPropagation>
            <div class="modal-top"><div><div class="eyebrow">CAMPAIGN NPC</div><h2>Delete this NPC?</h2></div><button class="icon-button" @onclick="CancelDeleteNpc">×</button></div>
            <p class="session-delete-copy">“@deletingNpc.Name” and its notes will be removed from this campaign.</p>
            <div class="session-dialog-actions"><button class="outline-button" @onclick="CancelDeleteNpc">Cancel</button><button class="primary-button small danger-button" @onclick="DeleteNpcCard">Delete NPC</button></div>
        </section>
    </div>
}
@if (BestiaryPendingDelete is { } deletingBestiary)
{
    <div class="modal-backdrop" @onclick="CancelDeleteBestiary">
        <section class="session-dialog" role="dialog" aria-modal="true" aria-label="Delete Bestiary entry" @onclick:stopPropagation>
            <div class="modal-top"><div><div class="eyebrow">CAMPAIGN BESTIARY</div><h2>Delete @deletingBestiary.Name?</h2></div><button class="icon-button" @onclick="CancelDeleteBestiary">×</button></div>
            <p class="session-delete-copy">This creature-type reference card and its local portrait will be removed from the campaign.</p>
            <div class="session-dialog-actions"><button class="outline-button" @onclick="CancelDeleteBestiary">Cancel</button><button class="primary-button small danger-button" @onclick="DeleteBestiaryCard">Delete Entry</button></div>
        </section>
    </div>
}
@if (State.PendingPlayerUpdate is { } playerUpdate)
{
    <div class="modal-backdrop player-update-backdrop" @onclick="CancelPlayerSheetUpdate">
        <section class="session-dialog player-update-dialog" role="dialog" aria-modal="true" aria-label="Review Player Sheet update" @onclick:stopPropagation>
            <div class="modal-top"><div><div class="eyebrow">PLAYER SHEET UPDATE</div><h2>Review proposed update</h2></div><button class="icon-button" title="Cancel" @onclick="CancelPlayerSheetUpdate" disabled="@PlayerUpdateApplying">×</button></div>
            <div class="player-update-columns">
                <section class="player-update-column"><div class="eyebrow">ORIGINAL</div><div class="player-update-document markdown-preview">@(string.IsNullOrWhiteSpace(playerUpdate.OriginalMarkdown) ? (MarkupString)"<p class=\"player-update-empty\">Player Sheet is empty.</p>" : (MarkupString)PlayerMarkdownRenderer.Render(playerUpdate.OriginalMarkdown, playerUpdate.CampaignId, PlayerImages, interactive: false))</div></section>
                <section class="player-update-column"><div class="eyebrow">UPDATED</div><div class="player-update-document markdown-preview">@((MarkupString)PlayerMarkdownRenderer.Render(playerUpdate.UpdatedMarkdown, playerUpdate.CampaignId, PlayerImages, interactive: false))</div></section>
            </div>
            @if (!string.IsNullOrWhiteSpace(PlayerUpdateError)) { <p class="player-update-error">@PlayerUpdateError</p> }
            <div class="session-dialog-actions"><button class="outline-button" @onclick="CancelPlayerSheetUpdate" disabled="@PlayerUpdateApplying">Cancel</button><button class="primary-button small" @onclick="() => ApprovePlayerSheetUpdate(playerUpdate)" disabled="@PlayerUpdateApplying">@(PlayerUpdateApplying ? "Saving Player Sheet…" : "Apply Update")</button></div>
        </section>
    </div>
}
@if (State.PendingGmNote is { } gmNoteProposal)
{
    <div class="modal-backdrop gm-note-proposal-backdrop" @onclick="CancelGmNoteReview">
        <section class="session-dialog gm-note-proposal-dialog" role="dialog" aria-modal="true" aria-label="Review GM Note" @onclick:stopPropagation>
            <div class="modal-top"><div><div class="eyebrow">CAMPAIGN NOTEBOOK</div><h2>Save this GM Note?</h2></div><button class="icon-button" title="Cancel" @onclick="CancelGmNoteReview">×</button></div>
            <p class="gm-note-proposal-copy">The GM proposes saving this as durable campaign-operating reference. It will be available to read on demand and will not be added to every GM request.</p>
            <div class="gm-note-proposal-text">@gmNoteProposal.Text</div>
            @if (!string.IsNullOrWhiteSpace(GmNoteProposalError)) { <p class="player-update-error">@GmNoteProposalError</p> }
            <div class="session-dialog-actions"><button class="outline-button" @onclick="CancelGmNoteReview">Cancel</button><button class="primary-button small" @onclick="() => ApproveGmNoteReview(gmNoteProposal)">Save GM Note</button></div>
        </section>
    </div>
}
@if (State.PendingBestiaryProposal is { } bestiaryProposal)
{
    <div class="modal-backdrop bestiary-review-backdrop" @onclick="CancelBestiaryReview">
        <section class="session-dialog bestiary-review-dialog" role="dialog" aria-modal="true" aria-label="Review Bestiary change" @onclick:stopPropagation>
            <div class="modal-top"><div><div class="eyebrow">@(bestiaryProposal.IsCreate ? "ADD TO BESTIARY" : $"BESTIARY UPDATE · {bestiaryProposal.Updated.Name.ToUpperInvariant()}")</div><h2>@(bestiaryProposal.IsCreate ? bestiaryProposal.Updated.Name : "Review proposed card")</h2></div><button class="icon-button" title="Cancel" @onclick="CancelBestiaryReview" disabled="@BestiaryProposalApplying">×</button></div>
            @if (bestiaryProposal.IsCreate)
            {
                <div class="bestiary-create-preview"><BestiaryCardView Entry="bestiaryProposal.Updated" PortraitDataUrl="@PortraitStore.ReadBestiaryDataUrl(bestiaryProposal.CampaignId, bestiaryProposal.Updated.Id, bestiaryProposal.Updated.PortraitExtension)" Frame="@PortraitStore.ReadBestiaryFrame(bestiaryProposal.CampaignId, bestiaryProposal.Updated.Id, bestiaryProposal.Updated.PortraitExtension)" /></div>
            }
            else if (bestiaryProposal.Original is { } originalBestiary)
            {
                <div class="player-update-columns bestiary-review-columns">
                    <section class="player-update-column"><div class="eyebrow">ORIGINAL</div><div class="player-update-document bestiary-review-document"><BestiaryCardView Entry="originalBestiary" PortraitDataUrl="@PortraitStore.ReadBestiaryDataUrl(bestiaryProposal.CampaignId, originalBestiary.Id, originalBestiary.PortraitExtension)" Frame="@PortraitStore.ReadBestiaryFrame(bestiaryProposal.CampaignId, originalBestiary.Id, originalBestiary.PortraitExtension)" /></div></section>
                    <section class="player-update-column"><div class="eyebrow">UPDATED</div><div class="player-update-document bestiary-review-document"><BestiaryCardView Entry="bestiaryProposal.Updated" PortraitDataUrl="@PortraitStore.ReadBestiaryDataUrl(bestiaryProposal.CampaignId, bestiaryProposal.Updated.Id, originalBestiary.PortraitExtension)" Frame="@PortraitStore.ReadBestiaryFrame(bestiaryProposal.CampaignId, originalBestiary.Id, originalBestiary.PortraitExtension)" /></div></section>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(BestiaryProposalError)) { <p class="player-update-error">@BestiaryProposalError</p> }
            <div class="session-dialog-actions"><button class="outline-button" @onclick="CancelBestiaryReview" disabled="@BestiaryProposalApplying">Cancel</button><button class="primary-button small" @onclick="() => ApproveBestiaryReview(bestiaryProposal)" disabled="@BestiaryProposalApplying">@(BestiaryProposalApplying ? "Saving…" : bestiaryProposal.IsCreate ? "Add to Bestiary" : "Apply Update")</button></div>
        </section>
    </div>
}
<ImageViewer IsOpen="ShowPortraitViewer" DataUrl="@EditingNpcPortraitUrl" Title="@NpcNameDraft" OnClose="ClosePortraitViewer" />
<ImageViewer IsOpen="ShowBestiaryPortraitViewer" DataUrl="@BestiaryPortraitUrl" Title="@(ActiveBestiary?.Name ?? BestiaryNameDraft)" OnClose="CloseBestiaryPortraitViewer" />
