@using Microsoft.AspNetCore.Components.Forms
@inject AppState State
@inject LlamaClient Client
@inject PaperWindowManager PaperWindows
@inject CampaignWindowManager CampaignWindows
@inject MobileWebHostManager MobileWeb
@inject PrivacyLockStore Privacy
@inject PaperDocumentState Paper
@inject PlayerImageAssetStore PlayerImages
@inject ViewOrderStore ViewStore
@inject LlamaModelInfoClient ModelInfo
@inject NpcPortraitStore PortraitStore
@inject ChronicleImageAssetStore ChronicleImages
@implements IDisposable

<div class="shell @(MobileHost ? $"mobile-space-host {MobileSpaceHostClass}" : "")">
    @if (!MobileHost)
    {
    <aside class="rail">
        <div class="brand"><GmThinkingSigil Size="84" Label="DBLC" Animated="false" /><div><div class="brand-name">DBLC</div><div class="eyebrow">GAME MASTER'S DESK</div></div></div>
        <button class="new-chat" @onclick="CampaignWindows.OpenOrActivate"><span>＋</span> Campaign</button>
        <div class="session-list-heading"><div class="section-label">SESSIONS <span>@State.ActiveConversations.Count()</span></div><button class="workbench-create-link" title="Create a disposable Workbench for this Session" @onclick="OpenWorkbenchCreate" disabled="@(State.Current is null || CurrentParentSession is null || CurrentParentSession.IsEnded || State.Busy)">＋ Workbench</button></div>
        <div class="conversation-list">
            @foreach (var session in State.ActiveConversations)
            {
                <div @key="session.Id" class="session-row" draggable="true" data-session-id="@session.Id" @oncontextmenu="e => OpenSessionMenu(session, e)" @oncontextmenu:preventDefault @onmouseenter="e => ShowSessionSummary(session, e)" @onmouseleave="ScheduleHideSessionSummary">
                    <button class="conversation @(State.Current?.Id == session.Id ? "active" : "")" @onclick="() => SelectConversation(session)" title="@session.Title">
                        <span class="chat-dot"></span><span class="session-copy"><small>SESSION @(session.SessionNumber ?? 1)@(session.IsEnded ? " · ENDED" : "")</small><span class="chat-title">@session.Title</span></span>
                    </button>
                    <button class="session-menu-trigger" title="Session options" @onclick="e => OpenSessionMenu(session, e)" @onclick:stopPropagation>···</button>
                </div>
                @foreach (var workbench in State.GetWorkbenches(session.Id))
                {
                    <button @key="workbench.Id" class="workbench-row @(State.Current?.Id == workbench.Id ? "active" : "")" @onclick="() => SelectConversation(workbench)" title="Resume @workbench.Title"><span class="workbench-branch">└─</span><span>@workbench.Title</span></button>
                }
            }
        </div>
        @if (State.Current?.IsWorkbench == true)
        {
            <div class="session-actions workbench-session-actions">
                <button class="session-action end-workbench-button" @onclick="RequestEndWorkbench" disabled="@(SessionActionBusy || State.Busy || State.WorkbenchExitReviewBusy)">@(SessionActionBusy || State.WorkbenchExitReviewPreparing ? "Checking…" : "Review & End")</button>
                <button class="session-action discard-workbench-button" @onclick="DiscardWorkbenchNow" disabled="@(SessionActionBusy || State.Busy)">Discard & Exit</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(WorkbenchExitError)) { <div class="workbench-exit-error">@WorkbenchExitError</div> }
                @if (!string.IsNullOrWhiteSpace(State.WorkbenchExitNotice)) { <div class="workbench-exit-error">@State.WorkbenchExitNotice</div> }
        }
        else
        {
            <div class="session-actions">
                <button class="session-action" @onclick="SummarizeCurrentSession" disabled="@(SessionActionBusy || State.Busy || State.Current is null || State.Current.IsEnded)">@(SessionActionBusy && !EndingSession ? "Summarizing…" : "Summarize Session")</button>
                <button class="session-action" @onclick="EndCurrentSession" disabled="@(SessionActionBusy || State.Busy || State.Current is null || State.Current.IsEnded)">@(SessionActionBusy && EndingSession ? "Ending…" : "End Session")</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(SessionActionStatus)) { <div class="session-action-status">@SessionActionStatus</div> }
        <div class="rail-bottom"><span class="online-dot"></span><span>Local sessions</span><span class="rail-version">V1</span></div>
    </aside>
    }

    <main class="main-area">
        @if (MobileHost && MobileSection != "Table")
        {
            <header class="mobile-space-topbar">
                <button class="mobile-space-back" type="button" @onclick="ReturnToMobileChronicle">‹ Chronicle</button>
                <span>@MobileSectionTitle</span>
            </header>
        }
        @if (!MobileHost)
        {
        <header class="topbar">
            <div class="crumb">@for (var i = 0; i < ViewOrder.Count; i++) { var view = ViewOrder[i]; <button class="view-tab @(ActiveView == view ? "selected" : "")" @onclick="() => SetView(view)">@view.ToUpperInvariant()</button>@if (i < ViewOrder.Count - 1) { <span>/</span> } }</div>
            <button class="settings-toggle" @onclick="ToggleSettings">⚙ <span>Settings</span></button>
        </header>
        }

        @if (ShowSettings)
        {
            <section class="settings-panel">
                <div class="settings-heading"><div><div class="eyebrow">DBLC CONFIGURATION</div><h2>Settings</h2></div><button class="icon-button" @onclick="CloseSettings">×</button></div>
                <div class="settings-layout">
                    <nav class="settings-nav" aria-label="Settings sections">
                        @foreach (var settingsTab in SettingsSections)
                        {
                            <button class="settings-nav-item @(SettingsSection == settingsTab ? "selected" : "")" @onclick="() => SelectSettingsSection(settingsTab)">@settingsTab</button>
                        }
                    </nav>
                    <div class="settings-content">
                @if (SettingsSection == "GENERAL")
                {
                    <div class="settings-section-scroll">
                <div class="settings-grid">
                    <label>OpenAI-compatible endpoint<input @bind="State.Endpoint" @bind:event="oninput" placeholder="http://127.0.0.1:8081/v1" /></label>
                    <label>Fallback model id<input @bind="State.Model" @bind:event="oninput" placeholder="Used if model discovery is unavailable" /></label>
                    @if (!MobileHost) { <label class="wide">Library folder<div class="folder-input"><input readonly value="@State.LibraryFolder" /><button class="outline-button" @onclick="PickFolder">Choose folder</button></div></label> }
                    else { <label class="wide">Library folder<div class="folder-input"><input readonly value="Managed on this PC" /><button class="outline-button" disabled>PC only</button></div></label> }
                </div>
                @if (!string.IsNullOrWhiteSpace(LibraryStatus)) { <div class="npc-editor-status">@LibraryStatus</div> }
                <label class="chronicle-text-size-setting"><span><strong>Chronicle Text Size</strong><small>Scales message prose and speaker portraits. Larger text wraps sooner and may make the Chronicle longer to scroll.</small></span><select value="@State.ChronicleTextSizePercent" @onchange="SetChronicleTextSize"><option value="100">Normal · 100%</option><option value="112">Large · 112%</option><option value="125">Extra Large · 125%</option></select></label>
                <div class="view-order-setting"><div class="eyebrow">NAVIGATION ORDER</div><div class="view-order-list">@foreach (var item in ViewOrder) { <div class="view-order-row"><span>@item</span><div><button class="order-button" title="Move up" disabled="@(ViewOrder.IndexOf(item) == 0)" @onclick="() => MoveView(item, -1)">↑</button><button class="order-button" title="Move down" disabled="@(ViewOrder.IndexOf(item) == ViewOrder.Count - 1)" @onclick="() => MoveView(item, 1)">↓</button></div></div> }</div></div>
                @if (!MobileHost)
                {
                    <section class="privacy-lock-setting">
                        <div class="eyebrow">DESKTOP PRIVACY</div>
                        <label class="gm-expression-setting"><span><strong>Close to system tray</strong><small>Closing the window keeps DBLC and mobile access running. Use the tray icon to reopen or exit.</small></span><input type="checkbox" checked="@Privacy.CloseToTrayEnabled" @onchange="ToggleCloseToTray" /></label>
                        <label class="gm-expression-setting"><span><strong>Require PIN when opening DBLC</strong><small>Protects startup and opening from the tray with the same four-digit PIN.</small></span><input type="checkbox" checked="@Privacy.HasPin" @onchange="TogglePrivacyPin" /></label>
                        @if (Privacy.HasPin) { <button class="outline-button" @onclick="ChangePrivacyPin">Change PIN</button><button class="outline-button" @onclick="RemovePrivacyPin">Remove PIN</button> }
                        <p>PIN protects the DBLC window from casual access. It does not encrypt campaign data and can be reset locally.</p>
                        @if (!string.IsNullOrEmpty(PrivacyStatus)) { <div class="player-mark-error">@PrivacyStatus</div> }
                    </section>
                }
                <label class="gm-expression-setting"><span><strong>GM Flavor Fonts</strong><small>Allow occasional typographic styles and visual glitch effects for character voices.</small></span><input type="checkbox" @bind="State.GmFlavorFontsEnabled" /></label>
                <label class="gm-expression-setting"><span><strong>GM thinking sigil</strong><small>Replace the lower-left thinking dots and rotating text with the animated 45px ASCII sigil. The upper-right status stays the same.</small></span><input type="checkbox" @bind="State.GmThinkingSigilEnabled" /></label>
                                <section class="gm-presentation-settings">
                    <div class="eyebrow">GM PRESENTATION</div>
                    <label class="gm-expression-setting"><span><strong>Enable streaming effects</strong><small>New GM narration arrives with a brief one-shot visual effect. Off by default; reduced-motion settings are always respected.</small></span><input type="checkbox" @bind="State.GmStreamAnimationsEnabled" @bind:after="OnGmPresentationSettingsChanged" /></label>
                    <label class="gm-presentation-select"><span>Default effect</span><select @bind="State.GmStreamDefaultEffect" @bind:after="OnGmPresentationSettingsChanged" disabled="@(!State.GmStreamAnimationsEnabled)">@foreach (var effect in GmNarrationMarkerParser.Effects) { <option value="@effect">@PresentationEffectLabel(effect)</option> }</select></label>
                    <label class="gm-expression-setting"><span><strong>Allow GM-selected inline effects</strong><small>The GM may use optional narration markers to change effects temporarily. Markers stay hidden even when this is off.</small></span><input type="checkbox" @bind="State.GmInlineStreamEffectsEnabled" @bind:after="OnGmPresentationSettingsChanged" disabled="@(!State.GmStreamAnimationsEnabled)" /></label>
                </section>
                <label class="gm-expression-setting vision-setting"><span><strong>Vision</strong><small>Allow PNG and JPEG image input in the Table composer.</small></span><input type="checkbox" @bind="State.VisionEnabled" @bind:after="OnVisionSettingChanged" /></label>
                <section class="mobile-access-setting">
                    <div class="eyebrow">PRIVATE PHONE ACCESS</div>
                    <h3>Mobile Web</h3>
                    <p>When enabled, DBLC starts a browser host on this PC's loopback address. Use Tailscale Serve to make it reachable only inside your tailnet.</p>
                    <label class="gm-expression-setting"><span><strong>Enable mobile browser access</strong><small>Off by default. This does not configure Tailscale or expose a public website.</small></span><input type="checkbox" checked="@State.MobileRemoteAccessEnabled" @onchange="ToggleMobileAccess" /></label>
                    <div class="mobile-access-actions"><button class="outline-button" @onclick="GenerateMobileAccessCode">@(State.HasMobileAccessCode ? "Rotate access code" : "Create access code")</button>@if (!string.IsNullOrWhiteSpace(State.MobileAccessCodeToShow)) { <code>@State.MobileAccessCodeToShow</code> }</div>
                    @if (!string.IsNullOrWhiteSpace(MobileAccessError)) { <div class="player-mark-error">@MobileAccessError</div> }
                    <div class="mobile-host-status">@MobileWeb.Status</div>
                    @if (State.MobileRemoteAccessEnabled) { <div class="mobile-serve-command"><span>After Tailscale is signed in on both devices, run in a terminal with Tailscale permission:</span><code>tailscale serve @State.MobileRemoteAccessPort</code><small>Use Serve only. Do not enable Funnel. Run <code>tailscale serve status</code> to see the private URL.</small></div> }
                </section>
                <section class="player-mark-setting">
                    <div class="player-mark-heading"><div><div class="eyebrow">CHRONICLE PRESENTATION</div><h3>Player Mark</h3><p>Choose one character for your Chronicle messages.</p></div><button class="outline-button" @onclick="ResetPlayerMark">Reset to Default</button></div>
                    <div class="player-mark-control"><input @bind="PlayerMarkDraft" @bind:event="oninput" maxlength="2" list="player-mark-options" aria-label="Player Mark" /><span class="avatar player-mark-preview">@PlayerMarkPreview</span></div>
                    <datalist id="player-mark-options">@foreach (var mark in AppState.GmMarkPalette) { <option value="@mark"></option> }</datalist>
                    @if (!string.IsNullOrWhiteSpace(PlayerMarkError)) { <div class="player-mark-error">@PlayerMarkError</div> }
                </section>
                    </div>
                }
                @if (SettingsSection == "GM")
                {
                    <div class="settings-section-scroll">
                <section class="gm-profile-setting">
                    <div class="gm-profile-heading"><div><div class="eyebrow">PERSISTENT GM IDENTITY</div><h3>GM Profile</h3><p>Shape the GM’s voice, temperament, priorities, and approach to play. DBLC’s protected operating rules stay separate.</p></div><button class="outline-button" @onclick="ResetGmProfile">Reset to Default</button></div>
                    <textarea class="gm-profile-editor" @bind="State.GmProfile" @bind:event="oninput" spellcheck="true" aria-label="GM Profile" />
                </section>
                    </div>
                }
                @if (SettingsSection == "SURPRISE")
                {
                    <div class="settings-section-scroll">
                @if (State.ActiveCampaign is { } settingsCampaign)
                {
                    var machine = settingsCampaign.SurpriseMachine;
                    <section class="surprise-settings">
                        <div class="surprise-settings-heading"><div><div class="eyebrow">OPTIONAL CAMPAIGN ADDON</div><h3>Surprise Machine</h3></div><label class="surprise-enabled"><input type="checkbox" @bind="machine.Enabled" /> Enabled</label></div>
                        @if (!machine.Enabled)
                        {
                            <p class="surprise-note">Off: no beat counting, machine processing, or added context.</p>
                        }
                        else
                        {
                            <p class="surprise-note">Counts each completed player–GM exchange. When one fires, its packet is included in the GM’s next reply without an extra model call.</p>
                            <div class="surprise-validation">@MachineSettingsError</div>
                            <details class="surprise-section" open>
                                <summary>Pacing</summary>
                                <div class="surprise-fields">
                                    <label>Eligible after · minimum<input type="number" min="1" step="1" @bind="machine.EligibilityMinimum" /></label>
                                    <label>Eligible after · maximum<input type="number" min="1" step="1" @bind="machine.EligibilityMaximum" /></label>
                                    <label>Event chance · minimum %<input type="number" min="0" max="100" step="0.1" @bind="machine.EventProbabilityMinimumPercent" /></label>
                                    <label>Event chance · maximum %<input type="number" min="0" max="100" step="0.1" @bind="machine.EventProbabilityMaximumPercent" /></label>
                                    <label>After a surprise, suppress new events · minimum beats<input type="number" min="1" step="1" @bind="machine.InterruptionDurationMinimum" /></label>
                                    <label>After a surprise, suppress new events · maximum beats<input type="number" min="1" step="1" @bind="machine.InterruptionDurationMaximum" /></label>
                                    <label>Cooldown · minimum beats<input type="number" min="0" step="1" @bind="machine.CooldownMinimum" /></label>
                                    <label>Cooldown · maximum beats<input type="number" min="0" step="1" @bind="machine.CooldownMaximum" /></label>
                                    <label>Attach a Campaign Trigger · %<input type="number" min="0" max="100" step="0.1" @bind="machine.CampaignTriggerChancePercent" /></label>
                                </div>
                                <p class="surprise-note">If eligible, the machine independently rolls the event chance on each exchange. The suppression and cooldown count completed exchanges; they do not set how long the fictional event lasts. Eligibility and event chance are drawn at the start of each cycle; range changes take effect next cycle. With no Campaign Triggers, the trigger roll is skipped.</p>
                            </details>
                            <details class="surprise-section">
                                <summary>Aspect Weights <span>Relative weights</span></summary>
                                <SurpriseWeightEditor AspectName="Magnitude" Weights="machine.MagnitudeWeights" Keys="SurpriseDefaults.Magnitudes" />
                                <SurpriseWeightEditor AspectName="Source" Weights="machine.SourceWeights" Keys="SurpriseDefaults.Sources" />
                                <SurpriseWeightEditor AspectName="Change" Weights="machine.ChangeWeights" Keys="SurpriseDefaults.Changes" />
                                <SurpriseWeightEditor AspectName="Behavior" Weights="machine.BehaviorWeights" Keys="SurpriseDefaults.Behaviors" />
                                <SurpriseWeightEditor AspectName="Relation" Weights="machine.RelationWeights" Keys="SurpriseDefaults.Relations" />
                            </details>
                            <details class="surprise-section">
                                <summary>Campaign Triggers <span>@machine.CampaignTriggers.Count</span></summary>
                                <p class="surprise-note">Triggers are written by you and supplement the normal packet. Relative chance = this weight ÷ total weight of all triggers. Example: weights 1, 1, and 2 = 25%, 25%, and 50% of trigger draws.</p>
                                @foreach (var trigger in machine.CampaignTriggers)
                                {
                                    <div class="campaign-trigger-editor" @key="trigger">
                                        <label>Name<input @bind="trigger.Name" maxlength="80" placeholder="Grateful Villagers" /></label>
                                        <label>Prompt<textarea @bind="trigger.Prompt" maxlength="500" rows="2" placeholder="People from villages the party helped may appear or intervene." /></label>
                                        <label>Weight<input type="number" min="0.01" step="0.1" @bind="trigger.Weight" /></label>
                                        <span class="trigger-share">@TriggerShare(machine.CampaignTriggers, trigger).ToString("0.#")% of trigger draws</span>
                                        <button class="outline-button" @onclick="() => machine.CampaignTriggers.Remove(trigger)">Remove</button>
                                    </div>
                                }
                                <button class="outline-button" @onclick="() => machine.CampaignTriggers.Add(new CampaignTrigger())">+ Add Campaign Trigger</button>
                            </details>
                            <button class="outline-button surprise-reset" @onclick="ResetSurpriseDefaults">Reset to Defaults</button>
                        }
                    </section>
                }
                    </div>
                }
                @if (SettingsSection == "CAMPAIGN")
                {
                    <div class="settings-section-scroll campaign-settings-content">
                @if (State.ActiveCampaign is { } notesCampaign)
                {
                    var gmNotes = State.GetGmNotes(notesCampaign.Id);
                    var shownGmNotes = gmNotes.Where(note => GmNotesFocusedId is { } focusedId ? note.Id == focusedId :
                        string.IsNullOrWhiteSpace(GmNotesFilter) || note.Text.Contains(GmNotesFilter, StringComparison.OrdinalIgnoreCase)).Take(50).ToList();
                    var dateTimeSettings = notesCampaign.DateTimeSettings;
                    var weekdaysValid = CampaignCalendar.TryParseNames(dateTimeSettings.CustomWeekdays, 32, out var configuredWeekdays, out _);
                    var periodsValid = CampaignCalendar.TryParsePeriods(dateTimeSettings.CustomPeriods, out var configuredPeriods, out _);
                    <section class="surprise-settings campaign-date-time-settings">
                        <div class="surprise-settings-heading"><div><div class="eyebrow">FICTIONAL CAMPAIGN CLOCK</div><h3>Date &amp; Time</h3></div></div>
                        <label class="surprise-enabled"><input type="checkbox" @bind="dateTimeSettings.UniversalTimeEnabled" /> Universal Time</label>
                        <p class="surprise-note">Uses DBLC’s ordinary 24-hour day and current time. This is fictional campaign time, unrelated to your computer clock or timezone.</p>
                        <label class="calendar-mode-field">Calendar
                            <select value="@dateTimeSettings.CalendarMode" @onchange="e => ChangeCalendarMode(dateTimeSettings, e.Value?.ToString())">
                                <option value="DayCount">Day Count</option>
                                <option value="Gregorian">Gregorian</option>
                                <option value="Custom">Custom</option>
                            </select>
                        </label>
                        @if (dateTimeSettings.CalendarMode == "Gregorian")
                        {
                            <label class="calendar-anchor-field">Date on the current campaign day<input type="date" @bind="dateTimeSettings.GregorianAnchorDate" @bind:after="CalendarSettingsEdited" /></label>
                            <p class="surprise-note">The selected date anchors to the campaign’s current canonical day when settings are saved.</p>
                        }
                        else if (dateTimeSettings.CalendarMode == "Custom")
                        {
                            <div class="calendar-custom-fields">
                                <label>Weekdays · one per line<textarea rows="4" @bind="dateTimeSettings.CustomWeekdays" @bind:event="oninput" @bind:after="CalendarSettingsEdited" aria-label="Custom calendar weekdays" /></label>
                                <label>Months / periods · Name, days<textarea rows="4" @bind="dateTimeSettings.CustomPeriods" @bind:event="oninput" @bind:after="CalendarSettingsEdited" placeholder="Firstmonth, 30&#10;Secondmonth, 27" aria-label="Custom calendar periods" /></label>
                                <div class="calendar-current-date-grid">
                                    <label>Current weekday<input @bind="dateTimeSettings.CustomAnchorWeekday" @bind:event="oninput" @bind:after="CalendarSettingsEdited" list="calendar-weekday-options" /></label>
                                    <label>Day of month<input type="number" min="1" max="1000" @bind="dateTimeSettings.CustomAnchorDay" @bind:after="CalendarSettingsEdited" /></label>
                                    <label>Current month<input @bind="dateTimeSettings.CustomAnchorPeriod" @bind:event="oninput" @bind:after="CalendarSettingsEdited" list="calendar-period-options" /></label>
                                    <label>Year<input type="number" min="0" max="2000000" @bind="dateTimeSettings.CustomAnchorYear" @bind:after="CalendarSettingsEdited" /></label>
                                    <label class="calendar-era-field">Era · optional<input maxlength="60" @bind="dateTimeSettings.CustomEra" @bind:event="oninput" @bind:after="CalendarSettingsEdited" /></label>
                                </div>
                                <datalist id="calendar-weekday-options">@if (weekdaysValid) { @foreach (var weekday in configuredWeekdays) { <option value="@weekday"></option> } }</datalist>
                                <datalist id="calendar-period-options">@if (periodsValid) { @foreach (var period in configuredPeriods) { <option value="@period.Name"></option> } }</datalist>
                                <p class="surprise-note">This date anchors to the campaign’s current canonical day when settings are saved. Weekdays and periods advance deterministically from it.</p>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(CalendarSettingsError)) { <div class="surprise-validation">@CalendarSettingsError</div> }
                    </section>
                    <section class="gm-notes-setting">
                        <div class="gm-notes-heading"><div><div class="eyebrow">CAMPAIGN NOTEBOOK</div><h3>GM Notes</h3><p>Durable campaign-running reference: rulings, procedures, house rules, and other player-approved understandings. The GM reads them only when useful.</p></div></div>
                        <div class="gm-note-transfer-actions">
                            <button class="outline-button" @onclick="ExportGmNotesJson">Export JSON</button>
                            <button class="outline-button" @onclick="ExportGmNotesMarkdown">Export Markdown</button>
                            <label class="outline-button mobile-file-button">Import JSON<InputFile accept=".json,application/json" OnChange="LoadGmNoteImport" /></label>
                        </div>
                        <p class="surprise-note">Export and import the selected campaign's GM Notes. JSON preserves note IDs for transfer to another installation.</p>
                        @if (!string.IsNullOrWhiteSpace(GmNoteTransferStatus)) { <div class="surprise-validation" role="status">@GmNoteTransferStatus</div> }
                        @if (GmNoteImportPlan is { } notePlan && notePlan.CampaignId == notesCampaign.Id)
                        {
                            <div class="gm-note-import-preview">
                                <strong>Import preview · @GmNoteImportFileName</strong>
                                <p>Create @notePlan.CreatedCount · Update @notePlan.UpdatedCount · Skip @notePlan.Skipped · Reject @notePlan.Rejected</p>
                                <label><input type="checkbox" @bind="GmNoteImportAllowUpdates" @bind:after="RefreshGmNoteImportPreview" /> Replace notes with matching IDs whose text differs</label>
                                <p class="surprise-note">Conflicting IDs are rejected unless you explicitly allow updates. The selected campaign will be checked again before saving.</p>
                                @foreach (var reason in notePlan.RejectionReasons) { <div class="surprise-validation">@reason</div> }
                                <div class="gm-note-transfer-actions"><button class="outline-button" @onclick="ConfirmGmNoteImport" disabled="@(notePlan.CreatedCount + notePlan.UpdatedCount == 0)">Confirm Import</button><button class="text-button" @onclick="() => CancelGmNoteImport()">Cancel</button></div>
                            </div>
                        }
                        @if (GmNotesFocusedId is not null) { <button class="text-button" @onclick="() => GmNotesFocusedId = null">Show all GM Notes</button> }
                        else { <label class="gm-note-filter">Find a note<input @bind="GmNotesFilter" @bind:event="oninput" placeholder="Filter this campaign's notes…" /></label> }
                        @if (gmNotes.Count == 0) { <div class="gm-notes-empty">No GM Notes are retained for this campaign.</div> }
                        else { <p class="surprise-note">Showing @shownGmNotes.Count of @gmNotes.Count notes. Filter to find a particular note; at most 50 are displayed at once.</p> }
                        @foreach (var note in shownGmNotes)
                        {
                            <article @key="note.Id" class="gm-note-edit-row"><textarea @bind="note.Text" @bind:event="oninput" maxlength="1000" aria-label="GM Note" /><button class="text-button" title="Delete GM Note" @onclick="() => State.DeleteGmNote(notesCampaign.Id, note.Id)">Delete</button></article>
                        }
                        <div class="gm-note-new-row"><textarea @bind="NewGmNoteDraft" @bind:event="oninput" maxlength="1000" placeholder="Add a campaign note…" aria-label="New GM Note" /><button class="outline-button" @onclick="AddManualGmNote" disabled="@string.IsNullOrWhiteSpace(NewGmNoteDraft)">Add Note</button></div>
                    </section>
                }
                @if (State.ActiveCampaign is { } threadsSettingsCampaign)
                {
                    var threadSettings = threadsSettingsCampaign.OpenThreadReminderSettings;
                    <section class="surprise-settings open-thread-settings">
                        <div class="surprise-settings-heading"><div><div class="eyebrow">CAMPAIGN CONTINUITY</div><h3>Open Threads</h3></div><label class="surprise-enabled"><input type="checkbox" @bind="threadSettings.Enabled" /> Reminders enabled</label></div>
                        <p class="surprise-note">Occasionally reminds the GM of one unresolved campaign thread. A reminder is context, not an instruction; the GM decides whether it matters.</p>
                        @if (threadSettings.Enabled)
                        {
                            <div class="surprise-fields open-thread-interval-fields">
                                <label>Minimum reminder interval · beats<input type="number" min="1" max="1000" step="1" @bind="threadSettings.MinimumBeats" /></label>
                                <label>Maximum reminder interval · beats<input type="number" min="1" max="1000" step="1" @bind="threadSettings.MaximumBeats" /></label>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(OpenThreadSettingsError)) { <div class="surprise-validation">@OpenThreadSettingsError</div> }
