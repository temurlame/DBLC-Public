    [JSInvokable] public Task RejectComposerImage(string message) { ComposerImageError = message; return InvokeAsync(StateHasChanged); }
    private void SetComposerImage(string fileName, byte[] bytes)
    {
        var extension = System.IO.Path.GetExtension(fileName).ToLowerInvariant();
        var isPng = bytes.AsSpan().StartsWith(PngSignature);
        var isJpeg = bytes.Length >= 3 && bytes[0] == 0xff && bytes[1] == 0xd8 && bytes[2] == 0xff;
        if (!(isPng && extension == ".png") && !(isJpeg && extension is ".jpg" or ".jpeg"))
            throw new InvalidDataException("Choose a valid PNG or JPEG image.");
        if (bytes.Length is <= 0 or > ChronicleImageAssetStore.MaxImageBytes) throw new InvalidDataException("Choose an image smaller than 12 MB.");
        ComposerImage = new ComposerImageDraft(System.IO.Path.GetFileName(fileName), isPng ? "image/png" : "image/jpeg", bytes);
        ComposerImageError = "";
    }
    private void PickFolder()
    {
        if (MobileHost) { LibraryStatus = "Change the Library folder from DBLC on the Windows PC."; return; }
        using var dialog = new System.Windows.Forms.FolderBrowserDialog { Description = "Choose the folder containing your reference PDF books", UseDescriptionForTitle = true, SelectedPath = State.LibraryFolder };
        if (dialog.ShowDialog() == System.Windows.Forms.DialogResult.OK) { State.SetLibraryFolder(dialog.SelectedPath); LoadCatalogue(); }
    }
    private async Task SaveSettings()
    {
        if (!AppState.TryNormalizePlayerMark(PlayerMarkDraft, out var playerMark))
        {
            PlayerMarkError = "Enter one printable character, or choose a symbol from the suggestions.";
            return;
        }
        if (State.ActiveCampaign is { } campaign && !SurpriseDefaults.IsValid(campaign.SurpriseMachine, out var error))
        {
            MachineSettingsError = error;
            return;
        }
        if (State.ActiveCampaign is { } threadCampaign && !OpenThreadReminderScheduler.IsValid(threadCampaign.OpenThreadReminderSettings, out var threadError))
        {
            OpenThreadSettingsError = threadError;
            return;
        }
        if (State.ActiveCampaign is { } calendarCampaign)
        {
            var calendar = calendarCampaign.DateTimeSettings ??= new CampaignDateTimeSettings();
            if (!CampaignCalendar.TryValidate(calendar, out var calendarError))
            {
                CalendarSettingsError = calendarError;
                return;
            }
            if (CalendarSettingsChanged)
            {
                var currentCampaignDay = CampaignAgendaFormat.Day(calendarCampaign.Clock?.TotalMinutes ?? 8 * 60);
                if (calendar.CalendarMode == "Gregorian") calendar.GregorianAnchorCampaignDay = currentCampaignDay;
                if (calendar.CalendarMode == "Custom") calendar.CustomAnchorCampaignDay = currentCampaignDay;
            }
        }
        State.SetPlayerMark(playerMark);
        PlayerMarkDraft = playerMark;
        PlayerMarkError = "";
        MachineSettingsError = "";
        OpenThreadSettingsError = "";
        CalendarSettingsError = "";
        CalendarSettingsChanged = false;
        State.SaveSettings();
        await RefreshModelId();
        await RefreshContextMeterAsync();
        ShowSettings = false;
    }
    private void ShowCatalogue() { CatalogueText = "open"; }
