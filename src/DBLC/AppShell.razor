    private void PaperChanged()
    {
        if (State.Current is not { IsWorkbench: true } workbench || Paper.CampaignId != workbench.CampaignId) return;
        if (_workbenchPaperCampaignId != Paper.CampaignId)
        {
            CaptureWorkbenchPaperBaseline();
            return;
        }
        if (!string.Equals(_workbenchPlayerBaseline, Paper.PlayerMarkdown, StringComparison.Ordinal))
        {
            _workbenchPlayerBaseline = Paper.PlayerMarkdown;
            State.RecordWorkbenchArtifact("Player Sheet updated");
        }
        if (!string.Equals(_workbenchWorkspaceBaseline, Paper.Notes, StringComparison.Ordinal))
        {
