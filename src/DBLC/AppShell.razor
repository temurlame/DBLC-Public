    private IEnumerable<BestiaryEntry> FilteredBestiary => State.GetBestiary(State.ActiveCampaignId).Where(entry => string.IsNullOrWhiteSpace(BestiarySearch) || entry.Name.Contains(BestiarySearch.Trim(), StringComparison.OrdinalIgnoreCase)).OrderBy(entry => entry.Name, StringComparer.OrdinalIgnoreCase);
    private Conversation? CurrentParentSession => State.Current is { IsWorkbench: true, ParentSessionId: { } parentId }
        ? State.Conversations.FirstOrDefault(item => item.Id == parentId && !item.IsWorkbench)
        : State.Current;

    private void ShowLibraryTab() { CloseNpcEditor(); CloseBestiaryEditor(); CloseBestiaryDetail(); RightPaneTab = "Library"; }
    private void ShowNpcTab() { CloseNpcEditor(); CloseBestiaryEditor(); CloseBestiaryDetail(); RightPaneTab = "NPCs"; }
    private void ShowAgendaTab() { CloseNpcEditor(); CloseBestiaryEditor(); CloseBestiaryDetail(); RightPaneTab = "Agenda"; }
    private void EnsureAgendaCalendarView(CampaignDateTimeSettings? settings)
    {
        var mode = CampaignDateTimeSettings.NormalizeMode(settings?.CalendarMode);
        if (AgendaCalendarCampaignId == State.ActiveCampaignId && AgendaCalendarMode == mode) return;
        AgendaCalendarCampaignId = State.ActiveCampaignId;
        AgendaCalendarMode = mode;
        AgendaMonthOffset = 0;
        SelectedAgendaDay = null;
    }
    private void NavigateAgendaMonth(int direction) { AgendaMonthOffset = Math.Clamp(AgendaMonthOffset + direction, -24_000, 24_000); SelectedAgendaDay = null; }
    private void AgendaCalendarToday() { AgendaMonthOffset = 0; SelectedAgendaDay = CampaignAgendaFormat.Day(State.GetCampaignMinute(State.ActiveCampaignId)); }
    private void SelectAgendaDay(long day) => SelectedAgendaDay = day;
    private void ShowMapsTab() { CloseNpcEditor(); CloseBestiaryEditor(); CloseBestiaryDetail(); RightPaneTab = "Maps"; }
    private void ShowBestiaryTab() { CloseNpcEditor(); CloseBestiaryEditor(); CloseBestiaryDetail(); RightPaneTab = "Bestiary"; }
    private void SelectSettingsSection(string section) { if (SettingsSections.Contains(section, StringComparer.Ordinal)) SettingsSection = section; }
    private void CalendarSettingsEdited() { CalendarSettingsChanged = true; CalendarSettingsError = ""; }
    private void ChangeCalendarMode(CampaignDateTimeSettings settings, string? mode)
    {
        settings.CalendarMode = CampaignDateTimeSettings.NormalizeMode(mode);
        CalendarSettingsEdited();
    }
    private void BeginPlayerThreadCreate() { CreatingPlayerThread = true; EditingPlayerThreadId = null; PlayerThreadDraft = ""; PlayerThreadStatus = ""; }
    private void BeginPlayerThreadEdit(OpenThread thread) { if (thread.Visibility != "player") return; CreatingPlayerThread = false; EditingPlayerThreadId = thread.Id; PlayerThreadDraft = thread.Text; PlayerThreadStatus = ""; }
    private void CancelPlayerThreadEdit() { CreatingPlayerThread = false; EditingPlayerThreadId = null; PlayerThreadDraft = ""; }
    private void SavePlayerThreadEdit()
    {
        if (!State.SavePlayerOpenThread(State.ActiveCampaignId, EditingPlayerThreadId, PlayerThreadDraft, out var error)) { PlayerThreadStatus = error; return; }
        CreatingPlayerThread = false; EditingPlayerThreadId = null; PlayerThreadDraft = ""; PlayerThreadStatus = "Saved.";
    }
    private void ResolvePlayerThread(Guid id)
    {
        if (State.ResolvePlayerOpenThread(State.ActiveCampaignId, id)) PlayerThreadStatus = "Thread resolved.";
    }
    private string? ImportedMapImageUrl(ImportedMapDisplayEntry map, string kind)
    {
        if (MobileHost) return $"/campaign-maps/{State.ActiveCampaignId:D}/{map.Id:D}/{kind}";
        if (kind != "thumbnail") return State.GetOwnerMapDataUrl(State.ActiveCampaignId, map.Id, kind);
        var key = (CampaignId: State.ActiveCampaignId, MapId: map.Id);
        if (!_importedThumbCache.TryGetValue(key, out var cached))
            _importedThumbCache[key] = cached = State.GetOwnerMapDataUrl(key.CampaignId, key.MapId, "thumbnail") ?? "";
        return cached;
    }
    private void OpenImportedMap(ImportedMapDisplayEntry map)
    {
        ImportedMapViewerMapId = map.Id;
        ImportedMapViewerCampaignId = State.ActiveCampaignId;
        ImportedMapViewerUrl = ImportedMapImageUrl(map, "original");
        ImportedMapViewerTitle = map.Title;
        ShowImportedMapViewer = !string.IsNullOrWhiteSpace(ImportedMapViewerUrl);
        if (!ShowImportedMapViewer) ImportedMapStatus = "The image file for this map is unavailable.";
    }
    private void CloseImportedMapViewer() { ShowImportedMapViewer = false; ImportedMapViewerUrl = null; ImportedMapViewerMapId = null; }
    private void ImportMapImage()
    {
        if (MobileHost) return;
        using var dialog = new System.Windows.Forms.OpenFileDialog { Title = "Import campaign map", Filter = "Map images (*.png;*.jpg;*.jpeg;*.webp)|*.png;*.jpg;*.jpeg;*.webp", CheckFileExists = true, Multiselect = false };
        if (dialog.ShowDialog() != System.Windows.Forms.DialogResult.OK) return;
        try
        {
            var file = new FileInfo(dialog.FileName);
            if (file.Length is <= 0 or > CampaignMapAssetStore.MaxImageBytes) throw new InvalidDataException("Choose a map image smaller than 30 MB.");
            var map = State.ImportCampaignMap(State.ActiveCampaignId, Path.GetFileNameWithoutExtension(file.Name), file.Name, File.ReadAllBytes(file.FullName));
            ImportedMapStatus = $"Imported “{map.Title}”.";
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or NotSupportedException or UnauthorizedAccessException)
        { ImportedMapStatus = "Map import failed: " + ex.Message; }
    }
    private void EditImportedMap(Guid mapId)
    {
        if (MobileHost) return;
        var map = State.GetImportedMap(State.ActiveCampaignId, mapId);
        if (map is null) return;
        EditingImportedMap = map;
        ImportedMapTitleDraft = map.Title;
        ImportedMapDeleteConfirm = false;
        ImportedMapStatus = "";
    }
    private void CloseImportedMapEditor() { EditingImportedMap = null; ImportedMapDeleteConfirm = false; }
    private void SaveImportedMapEditor()
    {
        if (MobileHost || EditingImportedMap is not { } map) return;
        ImportedMapStatus = State.UpdateImportedMap(State.ActiveCampaignId, map.Id, ImportedMapTitleDraft);
        if (ImportedMapStatus == "Map updated.")
        {
            if (ImportedMapViewerMapId == map.Id) ImportedMapViewerTitle = map.Title;
            EditingImportedMap = null;
        }
    }
    private void DeleteEditingImportedMap()
    {
        if (MobileHost || EditingImportedMap is not { } map) return;
        if (!ImportedMapDeleteConfirm) { ImportedMapDeleteConfirm = true; return; }
        ImportedMapStatus = State.DeleteImportedMap(State.ActiveCampaignId, map.Id);
        _importedThumbCache.Remove((State.ActiveCampaignId, map.Id));
        EditingImportedMap = null;
        ImportedMapDeleteConfirm = false;
        CloseImportedMapViewer();
    }
    private void OpenNpc(NpcCard npc) { EditingNpc = npc; CreatingNpc = false; NpcNameDraft = npc.Name; NpcNotesDraft = npc.Notes; NpcPortrayalCueDraft = npc.PortrayalCue ?? ""; EditingNpcPortraitUrl = PortraitStore.ReadDataUrl(State.ActiveCampaignId, npc.Id, npc.PortraitExtension); NpcPortraitFrame = PortraitStore.ReadFrame(State.ActiveCampaignId, npc.Id, npc.PortraitExtension); NpcPortraitPositioning = false; NpcEditorStatus = ""; }
    private void BeginCreateNpc() { EditingNpc = null; CreatingNpc = true; PendingNpcId = Guid.NewGuid(); PendingNpcCampaignId = State.ActiveCampaignId; PendingNpcPortraitExtension = null; NpcNameDraft = ""; NpcNotesDraft = ""; NpcPortrayalCueDraft = ""; EditingNpcPortraitUrl = null; NpcPortraitFrame = new(); NpcPortraitPositioning = false; ShowPortraitViewer = false; NpcEditorStatus = ""; }
    private void CloseNpcEditor()
    {
        if (CreatingNpc && PendingNpcId != Guid.Empty) PortraitStore.DeletePortrait(PendingNpcCampaignId, PendingNpcId);
        EditingNpc = null; CreatingNpc = false; PendingNpcId = Guid.Empty; PendingNpcCampaignId = Guid.Empty; PendingNpcPortraitExtension = null; EditingNpcPortraitUrl = null; NpcPortraitFrame = new(); NpcPortraitPositioning = false; NpcPortrayalCueDraft = ""; ShowPortraitViewer = false; NpcEditorStatus = "";
    }
    private void SaveNpcEditor()
    {
        if (!CreatingNpc && EditingNpc is null) return;
        var name = CreatingNpc ? NpcNameDraft.Trim() : EditingNpc!.Name;
        var creating = CreatingNpc;
        var response = State.SaveNpc(State.ActiveCampaignId, name, NpcNotesDraft, creating ? null : NpcNameDraft, createOnly: creating, npcId: creating ? PendingNpcId : null, portraitExtension: creating ? PendingNpcPortraitExtension : null, portrayalCue: NpcPortrayalCueDraft);
        if (!response.StartsWith("NPC card saved:", StringComparison.Ordinal)) { NpcEditorStatus = response; return; }
        var saved = State.FindNpc(State.ActiveCampaignId, NpcNameDraft);
        EditingNpc = saved;
        CreatingNpc = false;
        PendingNpcId = Guid.Empty; PendingNpcCampaignId = Guid.Empty; PendingNpcPortraitExtension = null;
        NpcNameDraft = saved?.Name ?? NpcNameDraft.Trim();
        NpcNotesDraft = saved?.Notes ?? NpcNotesDraft;
        NpcPortrayalCueDraft = saved?.PortrayalCue ?? NpcPortrayalCueDraft;
