    private double TriggerShare(IReadOnlyCollection<CampaignTrigger> triggers, CampaignTrigger trigger)
    {
        var scale = triggers.Count > 0 ? triggers.Max(item => Math.Max(0, item.Weight)) : 0;
        if (scale <= 0) return 0;
        var total = triggers.Sum(item => Math.Max(0, item.Weight) / scale);
        return Math.Max(0, trigger.Weight) / scale / total * 100;
    }
