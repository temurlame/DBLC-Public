        State.Busy && State.Status == GenericWaitingStatus ? GenericActivityText : State.Status;
    private string[] RecentGmActivities
    {
        get { lock (_gmActivityHistoryLock) return _recentGmActivities.ToArray(); }
    }
    private void ObserveGmActivityStatus()
    {
        lock (_gmActivityHistoryLock)
        {
            var current = State.Status;
            if (string.Equals(current, _lastObservedGmStatus, StringComparison.Ordinal)) return;
            if (IsSpecificGmActivity(_lastObservedGmStatus) && !string.Equals(_lastObservedGmStatus, current, StringComparison.Ordinal))
            {
                if (_recentGmActivities.Count == 0 || !string.Equals(_recentGmActivities[^1], _lastObservedGmStatus, StringComparison.Ordinal))
                {
                    _recentGmActivities.Add(_lastObservedGmStatus!);
                    if (_recentGmActivities.Count > 2) _recentGmActivities.RemoveAt(0);
                }
            }
            _lastObservedGmStatus = current;
        }
    }
    private static bool IsSpecificGmActivity(string? status) =>
        !string.IsNullOrWhiteSpace(status) &&
        status is not GenericWaitingStatus and not "GM is responding…" and not "Ready";
