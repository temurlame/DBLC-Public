    private async Task SummarizeCurrentSession() => await SummarizeSession(endAfterSummary: false);
    private async Task EndCurrentSession() => await SummarizeSession(endAfterSummary: true);
    private async Task SummarizeSession(bool endAfterSummary)
    {
        var session = State.Current;
        if (SessionActionBusy || State.Busy || session is null || session.IsEnded) return;
        SessionActionBusy = true;
        EndingSession = endAfterSummary;
        SessionActionStatus = endAfterSummary ? "Preparing final session recap…" : "Asking the GM for a recap…";
        await InvokeAsync(StateHasChanged);
        try
        {
            var activeLines = session.Lines.Where(line => line.Role is "user" or "assistant").ToList();
            string? summary;
            if (activeLines.Count == 0 && string.IsNullOrWhiteSpace(session.ArchiveSummary))
                summary = "No chronicle messages were recorded during this session.";
            else if (endAfterSummary)
                summary = await LlamaClient.TryGenerateSessionSummaryForEndAsync(async () =>
                {
                    await RefreshModelId();
                    return await Client.SummarizeSessionAsync(State.Endpoint, ServerModelId ?? State.Model, activeLines, session.ArchiveSummary, session.OpeningSummary);
                });
            else
            {
                await RefreshModelId();
                summary = await Client.SummarizeSessionAsync(State.Endpoint, ServerModelId ?? State.Model, activeLines, session.ArchiveSummary, session.OpeningSummary);
            }
            if (!string.IsNullOrWhiteSpace(summary)) State.SaveSessionSummary(session, summary);
            else if (!endAfterSummary) throw new InvalidOperationException("The model returned an empty session summary.");
            if (endAfterSummary)
            {
                State.EndSessionAndStartNext(session);
                ActiveView = "Table";
                SessionActionStatus = $"Session {session.SessionNumber} ended. Session {State.Current?.SessionNumber} is ready.";
                await RefreshContextMeterAsync();
            }
            else SessionActionStatus = "Session summary saved. Hover over this session to read it.";
        }
        catch (Exception ex)
        {
            SessionActionStatus = "Could not summarize session: " + ex.Message;
        }
        finally
        {
            SessionActionBusy = false;
            EndingSession = false;
            await InvokeAsync(StateHasChanged);
        }
    }
