            State.ApplyPlayerSheetUpdate(pending, () => Paper.ApplyApprovedPlayerUpdate(pending.CampaignId, pending.OriginalMarkdown, pending.UpdatedMarkdown));
            PlayerUpdateError = "";
        }
        catch (Exception ex)
        {
            PlayerUpdateError = "The existing sheet was kept. DBLC could not save the update: " + ex.Message;
        }
        finally
        {
            PlayerUpdateApplying = false;
            await InvokeAsync(StateHasChanged);
        }
