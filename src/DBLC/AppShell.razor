                    <div class="gm-notes-heading"><div><div class="eyebrow">UNRESOLVED CAMPAIGN BUSINESS</div><h3>Player-visible Threads</h3><p>Loose ends, promises, and unanswered questions. Agenda is for when; Threads are for what remains unresolved.</p></div></div>
                    @if (EditingPlayerThreadId is not null || CreatingPlayerThread)
                    {
                        <div class="open-thread-editor"><label>Thread<textarea @bind="PlayerThreadDraft" @bind:event="oninput" maxlength="600" placeholder="What is still unresolved?" aria-label="Open Thread text"></textarea></label><div class="open-thread-editor-count">@PlayerThreadDraft.Length / 600</div><div class="open-thread-editor-actions"><button class="outline-button" @onclick="CancelPlayerThreadEdit">Cancel</button><button class="primary-button small" @onclick="SavePlayerThreadEdit">@(CreatingPlayerThread ? "Add Thread" : "Save Thread")</button></div></div>
                    }
                    else
                    {
