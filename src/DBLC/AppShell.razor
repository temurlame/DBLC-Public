@if (EditingImportedMap is { } mapToEdit && !MobileHost)
{
    <div class="modal-backdrop" @onclick="CloseImportedMapEditor">
        <section class="session-dialog saved-map-delete-dialog" role="dialog" aria-modal="true" aria-label="Manage imported map" @onclick:stopPropagation>
            <div class="modal-top"><div><div class="eyebrow">IMPORTED CAMPAIGN MAP</div><h2>Manage map</h2></div><button class="icon-button" @onclick="CloseImportedMapEditor">×</button></div>
            <label class="map-save-name maps-editor-name">Title<input @bind="ImportedMapTitleDraft" @bind:event="oninput" maxlength="100" /></label>
            @if (ImportedMapDeleteConfirm) { <p class="map-ui-status">Delete this image from the campaign? This cannot be undone.</p> }
            @if (!string.IsNullOrWhiteSpace(ImportedMapStatus)) { <div class="map-ui-status">@ImportedMapStatus</div> }
            <div class="session-dialog-actions"><button class="outline-button" @onclick="DeleteEditingImportedMap">@(ImportedMapDeleteConfirm ? "Confirm delete" : "Delete map")</button><button class="primary-button small" @onclick="SaveImportedMapEditor">Save</button></div>
        </section>
    </div>
}
