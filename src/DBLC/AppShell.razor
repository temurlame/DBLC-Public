            {
                <section class="chat-pane">
                <div class="chat-heading">
                    <div><div class="eyebrow">@(State.Current?.IsWorkbench == true ? $"WORKBENCH · SESSION {CurrentParentSession?.SessionNumber ?? 1}" : $"SESSION {State.Current?.SessionNumber ?? 1}{(State.Current?.IsEnded == true ? " · ENDED" : "")}")</div><h1>@(State.Current?.Title ?? "New session")</h1></div>
                    <div class="connection @(State.Busy && !MobileHost && !PlayerUpdateApplying ? "connection-activity-stack" : "")">
                        @if (State.Busy && !MobileHost && !PlayerUpdateApplying)
                        {
                            var recentActivities = RecentGmActivities;
                            <div class="gm-activity-stack" role="status" aria-live="polite">
                                @for (var i = 0; i < recentActivities.Length; i++)
                                {
                                    <div class="gm-activity-row gm-activity-history @(i == 0 ? "oldest" : "newer")">@recentActivities[i]</div>
                                }
                                <div class="gm-activity-row gm-activity-current"><span class="pulse-dot"></span>@ActivityStatus</div>
                            </div>
                        }
                        else
                        {
                            <span class="@(State.Busy || PlayerUpdateApplying ? "pulse-dot" : "online-dot")"></span>@(State.Busy || PlayerUpdateApplying || State.PendingPlayerUpdate is not null ? ActivityStatus : (ServerModelId ?? "LOCAL MODEL"))
                        }
                    </div>
                </div>
                <div class="chronicle-viewport">
                <div class="messages @(ChronicleNeedsInitialPosition ? "chronicle-positioning" : "")" style="--chronicle-text-scale: @State.ChronicleTextScaleCss" @ref="MessagesElement">
                    <div class="messages-content">
                    @if (!string.IsNullOrWhiteSpace(State.Current?.OpeningSummary))
                    {
                        <article class="session-opening-summary"><div class="session-opening-heading">PREVIOUS SESSION · @(State.Current?.PreviousSessionNumber ?? 0)</div><div><ChronicleText Text="@State.Current!.OpeningSummary" /></div></article>
                    }
                    @if (State.Current?.Lines.Count == 0)
                    {
                        <div class="welcome-card">
                            <div class="welcome-mark"><GmThinkingSigil Size="144" Label="DBLC" /></div>
                            <div class="eyebrow">@(State.Current?.IsWorkbench == true ? "TEMPORARY WORKBENCH" : "THE TABLE IS YOURS")</div>
                            <h2>@(State.Current?.IsWorkbench == true ? "What are we working through?" : "What happens next?")</h2>
                            <p>@(State.Current?.IsWorkbench == true ? "This conversation stays outside the Session Chronicle. When you end the Workbench, review any proposed campaign records and GM Notes before they are saved." : "Ask your GM anything. It can inspect the book catalogue and request pages when it needs them.")</p>
                        </div>
                    }
                    @foreach (var line in State.Current?.Lines ?? [])
                    {
                        @if (line.Role == "archive")
                        {
                            <article class="archive-summary-card"><div class="archive-summary-heading"><span>✧</span><span>ARCHIVED CHRONICLE SUMMARY</span><small>Original lines preserved locally</small></div><div class="archive-summary-content"><ChronicleText Text="@line.Content" /></div></article>
                        }
                        else if (line.EntryType == "campaign_record")
                        {
                            <article class="campaign-record-message">
                                <div class="campaign-record-label">CAMPAIGN RECORD</div>
                                <div class="campaign-record-content message-content"><ChronicleText Text="@line.Content" /></div>
                            </article>
                        }
                        else if (State.Busy && State.GmThinkingSigilEnabled && line.Role == "assistant" && string.IsNullOrEmpty(line.Content) && line.PresentationSegments is not { Count: > 0 } && ReferenceEquals(State.Current?.Lines.LastOrDefault(), line))
                        {
                            @* The aligned thinking row below represents this still-empty GM response. *@
                        }
                        else
                        {
                            {
                                <article @key="line.Id" class="message @(line.Role == "user" ? "user-message" : "gm-message")">
