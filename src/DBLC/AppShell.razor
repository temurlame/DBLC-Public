    private void UpdateGenericActivityRotation()
    {
        var waiting = State.Busy && State.Status == GenericWaitingStatus;
        if (waiting && _genericActivityRotation is null)
        {
            var rotation = new CancellationTokenSource();
            _genericActivityRotation = rotation;
            _ = RotateGenericActivityAsync(rotation);
        }
        else if (!waiting && _genericActivityRotation is { } rotation)
        {
            _genericActivityRotation = null;
            rotation.Cancel();
        }
    }
    private async Task RotateGenericActivityAsync(CancellationTokenSource rotation)
    {
        try
        {
            while (!rotation.IsCancellationRequested && State.Busy && State.Status == GenericWaitingStatus)
            {
                GenericActivityText = ActivityCatalog.PickActivity();
                StateHasChanged();
                await Task.Delay(Random.Shared.Next(4000, 6001), rotation.Token);
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            if (ReferenceEquals(_genericActivityRotation, rotation)) _genericActivityRotation = null;
            rotation.Dispose();
        }
    }
