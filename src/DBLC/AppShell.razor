    private void ExportSession()
    {
        if (MenuSession is not { } session) return;
        MenuSession = null;
        using var dialog = new System.Windows.Forms.SaveFileDialog
        {
            Title = "Export session chronicle",
            Filter = "Markdown document (*.md)|*.md",
            FileName = $"Session {session.SessionNumber} - {SafeFileName(session.Title)}.md",
            DefaultExt = "md",
            AddExtension = true
        };
        if (dialog.ShowDialog() != System.Windows.Forms.DialogResult.OK) return;
        var lines = State.GetCompleteChronicleLines(session);
        var output = new StringBuilder();
        output.Append("# Session ").Append(session.SessionNumber ?? 1).Append(" — ").AppendLine(session.Title).AppendLine();
        output.Append("Status: ").AppendLine(session.IsEnded ? "Ended" : "In progress");
        output.Append("Last activity: ").AppendLine(session.UpdatedAt.ToLocalTime().ToString("g")).AppendLine();
        if (!string.IsNullOrWhiteSpace(session.SessionSummary)) output.AppendLine("## Session summary").AppendLine().AppendLine(session.SessionSummary).AppendLine();
        if (!string.IsNullOrWhiteSpace(session.OpeningSummary)) output.AppendLine("## Previous session recap").AppendLine().AppendLine(session.OpeningSummary).AppendLine();
        output.AppendLine("## Chronicle").AppendLine();
        foreach (var line in lines)
        {
            output.Append("### ").Append(line.EntryType == "campaign_record" ? "Campaign Record" : line.Role == "user" ? "Player" : "GM").Append(" · ").AppendLine(line.DisplayTimestamp.ToLocalTime().ToString("g"));
            output.AppendLine();
            if (line.RollSides is { } sides) output.Append("<!-- DBLC roll d").Append(sides).AppendLine(" -->");
            output.AppendLine(line.Content).AppendLine();
        }
        try
        {
            File.WriteAllText(dialog.FileName, output.ToString(), new System.Text.UTF8Encoding(false));
            SessionActionStatus = "Session exported.";
        }
        catch (Exception ex) { SessionActionStatus = "Could not export session: " + ex.Message; }
    }
    private static string SafeFileName(string name)
    {
