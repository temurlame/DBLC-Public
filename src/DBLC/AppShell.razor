    private void OpenPdf()
    {
        if (!string.IsNullOrWhiteSpace(State.PdfPath) && File.Exists(State.PdfPath))
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(State.PdfPath) { UseShellExecute = true });
    }
    private async Task ApplyChronicleResponseStateAsync()
    {
        var pending = System.Threading.Interlocked.Exchange(ref _responseActivePending, -1);
        if (pending < 0) return;
        try
        {
            await JS.InvokeVoidAsync(pending == 1 ? "beginChronicleResponse" : "endChronicleResponse", MessagesElement);
        }
        catch { System.Threading.Interlocked.CompareExchange(ref _responseActivePending, pending, -1); }
    }
    private async Task ScrollToBottom()
    {
        try { await JS.InvokeVoidAsync("scrollMessagesToBottom", MessagesElement); } catch { }
    }
    private async Task JumpToLatest()
    {
