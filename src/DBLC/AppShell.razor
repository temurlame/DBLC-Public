    private int _stateRefreshQueued;
    private bool _disposed;
    private void StateChanged()
    {
        if (_disposed) return;
        var busy = State.Busy ? 1 : 0;
        var busyChanged = System.Threading.Interlocked.Exchange(ref _observedBusy, busy) != busy;
        if (busyChanged)
        {
            System.Threading.Interlocked.Exchange(ref _responseActivePending, busy);
            lock (_gmActivityHistoryLock)
            {
                if (busy == 1) _recentGmActivities.Clear();
                _lastObservedGmStatus = State.Status;
            }
        }
        if (busy == 1) ObserveGmActivityStatus();
        if (System.Threading.Interlocked.Exchange(ref _stateRefreshQueued, 1) != 0) return;
        _ = InvokeAsync(async () =>
        {
            // Preserve every state change; render the latest state once per display frame.
            await Task.Delay(16);
            System.Threading.Interlocked.Exchange(ref _stateRefreshQueued, 0);
            if (_disposed) return;
            if (_chronicleSessionKey != State.Current?.Id)
            {
                _chronicleSessionKey = State.Current?.Id;
                if (State.Current?.IsWorkbench == true) CaptureWorkbenchPaperBaseline();
                _chronicleNavigationPending = true;
                _chronicleResetToLatestPending = true;
                ChronicleNeedsInitialPosition = true;
            }
            RefreshStateView();
            UpdateGenericActivityRotation();
            StateHasChanged();
        });
    }
    private void RefreshStateView()
    {
        if (NpcUiCampaignId != State.ActiveCampaignId)
        {
            CloseNpcEditor();
            CloseBestiaryEditor();
            CloseBestiaryDetail();
            NpcUiCampaignId = State.ActiveCampaignId;
            NpcPendingDelete = null; NpcSearch = ""; BestiarySearch = ""; BestiaryPendingDelete = null;
        }
    }
