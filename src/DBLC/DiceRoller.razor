@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="dice-control @(Compact ? "dice-control-compact" : "")" @ref="_root" data-compact="@Compact.ToString().ToLowerInvariant()" data-session="@ConversationId">
    <button class="die-roll-button @(_result is null ? "" : _animation % 2 == 0 ? "rolling-a" : "rolling-b")" style="--die-mask:url('/images/dice/d@(_selected).png')" type="button" disabled="@(Disabled || ConversationId is null)" aria-label="Roll d@(_selected); hold to choose a die" title="Roll d@(_selected) · hold to choose a die" aria-haspopup="menu" aria-expanded="false">
        <img class="die-icon" src="images/dice/d@(_selected).png" alt="" aria-hidden="true" draggable="false" />
        @if (_result is { } result) { <span class="die-result">@result</span> }
        else { <span class="die-loaded-label" aria-hidden="true">d@(_selected)</span> }
    </button>
    <div class="die-picker" role="menu" aria-label="Choose a die" hidden>
        @foreach (var sides in Sides)
        {
            <button type="button" class="die-choice @(sides == _selected ? "selected" : "")" data-sides="@sides" role="menuitemradio" aria-checked="@(sides == _selected)" title="@(Compact ? $"Select d{sides}" : $"Roll d{sides}")">
                <img class="die-icon" src="images/dice/d@(sides).png" alt="" aria-hidden="true" draggable="false" /><span>d@(sides)</span>
            </button>
        }
    </div>
    @if (_error.Length > 0) { <span class="dice-control-error" role="status">@_error</span> }
</div>

@code {
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Guid? ConversationId { get; set; }
    [Parameter] public Func<DiceRollRequest, Task<bool>>? OnRoll { get; set; }
    private static readonly int[] Sides = [4, 6, 8, 10, 12, 20];
    [Parameter] public int SelectedSides { get; set; } = 20;
    [Parameter] public EventCallback<int> SelectedSidesChanged { get; set; }
    private int _selected => Sides.Contains(SelectedSides) ? SelectedSides : 20;
    private int _animation;
    private int? _result;
    private string _error = "";
    private ElementReference _root;
    private DotNetObjectReference<DiceRoller>? _reference;
    private CancellationTokenSource? _hide;
    private bool _disposed;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _reference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("diceControls.install", _root, _reference);
    }
    [JSInvokable] public async Task DiceAction(int sides, bool roll, string requestId, string sessionId)
    {
        if (_disposed || Disabled || !Sides.Contains(sides) || !Guid.TryParse(sessionId, out var session) || session != ConversationId) return;
        SelectedSides = sides; await SelectedSidesChanged.InvokeAsync(sides); _error = "";
        if (roll && Guid.TryParse(requestId, out var id) && OnRoll is not null)
        {
            var result = System.Security.Cryptography.RandomNumberGenerator.GetInt32(1, sides + 1);
            try
            {
                if (await OnRoll(new DiceRollRequest(id, session, sides, result)))
                {
                    _result = result; _animation++;
                    _hide?.Cancel(); _hide = new CancellationTokenSource();
                    _ = HideResultAsync(_hide);
                }
            }
            catch { _error = "Roll was not saved. Please try again."; }
        }
        if (!_disposed) await InvokeAsync(StateHasChanged);
    }
    private async Task HideResultAsync(CancellationTokenSource hide)
    {
        try
        {
            await Task.Delay(1350, hide.Token);
            if (!_disposed && ReferenceEquals(_hide, hide)) await InvokeAsync(() => { _result = null; StateHasChanged(); });
        }
        catch (OperationCanceledException) { }
        finally { hide.Dispose(); if (ReferenceEquals(_hide, hide)) _hide = null; }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; _hide?.Cancel();
        try { await JS.InvokeVoidAsync("diceControls.dispose", _root); } catch { }
        _reference?.Dispose();
    }
}
